---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartnerCard from '../../components/cards/PartnerCard.astro';
import { siteConfig } from '../../config/site';
import { getCollection } from 'astro:content';

const partners = await getCollection('partnerships');
const sortedPartners = partners.sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());
---

<BaseLayout title="Partnerships & Collaborations | UKABCS">
  <section class="page-header py-20 text-center">
    <div class="container">
      <span class="badge-pill badge-emerald">Synergy &amp; Impact</span>
      <h1 class="page-title mt-4">Partnerships &amp; Collaborations</h1>
      <p class="page-subtitle max-w-3xl mx-auto">
        We believe strategic partnerships are key to advancing biotechnology and computational science, ensuring our grants deliver sustainable, worldwide impact.
      </p>
    </div>
  </section>

  <!-- In-Kind Announcements Section -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-16">
        <span class="badge-pill">Major Donors &amp; Collaborators</span>
        <h2 class="text-3xl font-bold mt-2">Over £427,000 in Active Research Credits</h2>
        <p class="text-secondary mt-2">Pioneering alliances supporting global academic laboratories.</p>
      </div>

      <div class="grid-3 gap-8 mb-20">
        {sortedPartners.map((partner) => (
          <PartnerCard
            title={partner.data.title}
            partnerName={partner.data.partnerName}
            value={partner.data.value}
            type={partner.data.type}
            datePublished={partner.data.datePublished}
            description={partner.data.description}
            slug={partner.slug}
          />
        ))}
      </div>

      <!-- Types of Partnerships -->
      <div class="text-center mb-12">
        <span class="badge-pill">Collaboration Models</span>
        <h2 class="text-3xl font-bold mt-2">How You Can Partner with UKABCS</h2>
      </div>

      <div class="grid-3 gap-6 mb-20">
        <div class="flat-surface p-8">
          <h3 class="text-lg font-bold mb-2 text-primary">Academic Partnerships</h3>
          <p class="text-secondary text-sm leading-relaxed">Joint degree programs, co-funded research projects, and university faculty secondments.</p>
        </div>

        <div class="flat-surface p-8">
          <h3 class="text-lg font-bold mb-2 text-primary">Technology Alliances</h3>
          <p class="text-secondary text-sm leading-relaxed">Donations of GPU server hours, molecular modeling licenses, and cloud storage quotas for scientists.</p>
        </div>

        <div class="flat-surface p-8">
          <h3 class="text-lg font-bold mb-2 text-primary">Philanthropic Foundations</h3>
          <p class="text-secondary text-sm leading-relaxed">Co-funding targeted grant streams addressing regional health disparities and rare diseases.</p>
        </div>

        <div class="flat-surface p-8">
          <h3 class="text-lg font-bold mb-2 text-primary">Educational Providers</h3>
          <p class="text-secondary text-sm leading-relaxed">Co-producing bilingual workshops, educational curricula, and computational certifications.</p>
        </div>

        <div class="flat-surface p-8">
          <h3 class="text-lg font-bold mb-2 text-primary">Industry &amp; Biotech Firms</h3>
          <p class="text-secondary text-sm leading-relaxed">Connecting corporate R&amp;D teams with top academic talent through student graduation challenges.</p>
        </div>

        <div class="flat-surface p-8">
          <h3 class="text-lg font-bold mb-2 text-primary">Scientific Publishers</h3>
          <p class="text-secondary text-sm leading-relaxed">Providing APC fee waivers and special journal issues spotlighting UKABCS-supported research.</p>
        </div>
      </div>

      <!-- Process & Apply -->
      <div class="flat-surface p-12 max-w-4xl mx-auto text-center">
        <span class="badge-pill badge-emerald mb-3">Onboarding</span>
        <h2 class="text-3xl font-bold mb-4">Become an Official Partner</h2>
        <p class="text-secondary mb-8 leading-relaxed">
          Our streamlined 5-step partnership workflow ensures rapid agreement alignment and immediate listing on our global partner wall.
        </p>
        <a href={siteConfig.clientFlow.partnershipForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary btn-lg">
          <span>Submit Partnership Inquiry</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .py-20 { padding-top: 5rem; padding-bottom: 5rem; }
  .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
  .text-center { text-align: center; }
  .mx-auto { margin-inline: auto; }
  .max-w-3xl { max-width: 48rem; }
  .max-w-4xl { max-width: 56rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); }
  .gap-6 { gap: 1.5rem; }
  .gap-8 { gap: 2rem; }
  .p-8 { padding: 2rem; }
  .p-12 { padding: 3rem; }
  .mt-2 { margin-top: 0.5rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-2 { margin-bottom: 0.5rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-8 { margin-bottom: 2rem; }
  .mb-12 { margin-bottom: 3rem; }
  .mb-16 { margin-bottom: 4rem; }
  .mb-20 { margin-bottom: 5rem; }
  .text-lg { font-size: 1.125rem; }
  .text-3xl { font-size: 1.875rem; }
  .text-sm { font-size: 0.875rem; }
  .font-bold { font-weight: 700; }
  .text-primary { color: var(--color-primary); }
  .text-secondary { color: var(--color-text-secondary); }
  .leading-relaxed { line-height: 1.7; }
  .btn-lg { padding: 0.9rem 2rem; font-size: 1.05rem; }

  @media (max-width: 1024px) {
    .grid-3 { grid-template-columns: 1fr; }
  }
</style>
