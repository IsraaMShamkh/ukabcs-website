---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TextContentSection from '../../components/sections/TextContentSection.astro';
import PartnerRibbonSection from '../../components/sections/PartnerRibbonSection.astro';
import SalesPromoSection from '../../components/sections/SalesPromoSection.astro';
import FeaturesBentoSection from '../../components/sections/FeaturesBentoSection.astro';
import ArticlesBlogEventsSection from '../../components/sections/ArticlesBlogEventsSection.astro';
import GeneralSupportSection from '../../components/sections/GeneralSupportSection.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title={`Partnerships & Collaborations | ${siteConfig.publicName}`} description="Strategic collaborations with academic institutions, biotechnology companies, and scientific publishers advancing computational biology.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Global Consortium"
    title="Partnerships & Collaborations"
    description="Strategic collaborations across training, scientific software, computational collaboration, publishing and open science."
    image="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Why Partner With Us -->
  <TextContentSection
    tag="Collaborative Ecosystem"
    title="Why Partner with UKABCS?"
    subtitle="Connecting researchers, academic societies, and technology partners across the globe."
    content="UKABCS connects universities, training providers, software teams and scientific publishers under a governed, non-profit academic framework."
    image="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?q=80&w=1000&auto=format&fit=crop"
    ctaText="Submit Partnership Proposal →"
    ctaHref={siteConfig.clientFlow.partnershipForm}
  />

  <!-- 3. Partner icons/logos -->
  <PartnerRibbonSection />

  <!-- 4. Partnership types: existing programme-card section -->
  <SalesPromoSection
    sectionId="partnership-types"
    badge="Types of Partnerships"
    title="How We Can Work Together"
    subtitle="Partnerships designed to strengthen research, education, and global scientific collaboration."
    items={[
      { title: 'Partnership & Donation', description: 'Support research, education, and innovation through financial or non-financial contributions that empower researchers and strengthen scientific collaboration.' },
      { title: 'Academic Partnerships', description: 'Collaborate with universities and academic institutions to support researchers and students and co-develop research projects.' },
      { title: 'Technology Partnerships', description: 'Develop and use innovative software and tools with technology companies to facilitate and disseminate research.' },
      { title: 'Philanthropic Partnerships', description: 'Support research activities through donations, sponsorships, and scholarships to maximise scientific and social impact.' },
      { title: 'Educational Partnerships', description: 'Work with schools, training centres, and educational platforms to expand access to knowledge and build student capacity.' },
      { title: 'Industry Partnerships', description: 'Bridge scientific research with industry needs through applied projects and real-world products or solutions.' },
      { title: 'Service Partnerships', description: 'Provide in-kind resources or services, such as lab equipment, software platforms, products, or specialist training.' },
      { title: 'Other Partnership Models', description: 'We welcome innovative partnership ideas. Contact us and submit your proposal for review.' },
    ]}
  />

  <!-- 5. Partnership process: existing Bento section -->
  <FeaturesBentoSection
    sectionId="partnership-process"
    badge="Partnership Process"
    title="A Clear Route to Collaboration"
    subtitle="From your first enquiry to being listed as an official UKABCS partner."
    items={[
      { title: '01 · Get in Touch', description: 'Submit your interest via the partnership form or email.' },
      { title: '02 · Initial Review', description: 'Our team reviews your proposal to ensure alignment with our mission.' },
      { title: '03 · Partnership Agreement (MOU)', description: 'We prepare a Memorandum of Understanding outlining roles and mutual benefits.' },
      { title: '04 · Official Approval', description: 'The partnership is formally approved within three working days after signing.' },
      { title: '05 · Listing as a Partner', description: 'Your organisation’s name and logo are added to our Partners page and highlighted in our projects.' },
    ]}
  />

  <!-- 6. Same article-card section used on the Home page -->
  <ArticlesBlogEventsSection
    title="Partnerships & Collaborations Articles"
    subtitle="Updates on UKABCS collaborations, research credits, services, publishing support, and joint scientific impact."
    category="Partnerships"
    limit={6}
    tabs={[
      { id: 'all', label: 'All Partners' },
      { id: 'technology', label: 'Technology & Innovation', match: 'partnership-exovion|partnership-healora' },
      { id: 'research', label: 'Research & Industry', match: 'partnership-ebo' },
      { id: 'publishing', label: 'Publishing & Conferences', match: 'partnership-ijbtcs' },
      { id: 'education', label: 'Education & Training', match: 'partnership-bioinformatics-gate' },
    ]}
  />

  <!-- 7. Existing application/support section -->
  <GeneralSupportSection />

  <!-- 8. Promo CTA -->
  <PromoCTASection />
</BaseLayout>

<style>
  :global(.section-articles .news-card-media img[src^='/partners/']) {
    object-fit: contain;
    padding: 0.75rem;
    background: #ffffff;
  }
</style>
