---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TextContentSection from '../../components/sections/TextContentSection.astro';
import PartnerRibbonSection from '../../components/sections/PartnerRibbonSection.astro';
import SalesPromoSection from '../../components/sections/SalesPromoSection.astro';
import GeneralSupportSection from '../../components/sections/GeneralSupportSection.astro';
import DonationSection from '../../components/sections/DonationSection.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title={`Partnerships & Collaborations | ${siteConfig.publicName}`} description="Strategic collaborations with academic institutions, biotechnology companies, and scientific publishers advancing computational biology.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Global Consortium"
    title="Partnerships & Collaborations"
    description="Strategic collaborations with academic institutions, biotechnology companies, and scientific publishers advancing computational biology and open science."
    image="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Why Partner With Us -->
  <TextContentSection
    tag="Collaborative Ecosystem"
    title="Why Partner with UKABCS?"
    subtitle="Connecting researchers, academic societies, and technology partners across the globe."
    content="UKABCS unites university research departments, software vendors, and indexed journals under a governed, non-profit academic framework to deliver high-impact computational resources directly to researchers."
    image="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?q=80&w=1000&auto=format&fit=crop"
    ctaText="Submit Partnership Proposal →"
    ctaHref={siteConfig.clientFlow.partnershipForm}
  />

  <!-- 3. Partner Marquee Ribbon -->
  <PartnerRibbonSection />

  <!-- 4. Active Partnership Allocations (SalesPromo) -->
  <SalesPromoSection
    title="Active Partnership & Credit Allocations"
    subtitle="Explore current industry, university, and publishing agreements supporting UKABCS programs."
  />

  <!-- 5. General Support / Partnership Request -->
  <GeneralSupportSection />

  <!-- 6. Donation / Research Support Section -->
  <DonationSection />

  <!-- 7. Promo CTA -->
  <PromoCTASection />
</BaseLayout>
