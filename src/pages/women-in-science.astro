---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="Women Researchers Support | UKABCS">
  <section class="page-header py-20 text-center">
    <div class="container">
      <span class="badge-pill badge-emerald">Equality &amp; Inclusion</span>
      <h1 class="page-title mt-4">Empowering Women in Science</h1>
      <p class="page-subtitle max-w-3xl mx-auto">
        Practical, tangible initiatives designed to support women researchers in accelerating scientific careers while balancing family and professional commitments.
      </p>
    </div>
  </section>

  <!-- Key Support Streams -->
  <section class="py-16">
    <div class="container">
      <div class="grid-3 gap-6 mb-16">
        <div class="flat-surface p-8">
          <div class="support-icon mb-4">🎯</div>
          <h3 class="text-xl font-bold mb-3">Dedicated Grant Streams</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Women researchers apply through standard competitive calls, with earmarked funding quotas to guarantee equitable representation in biotechnology grants.
          </p>
        </div>

        <div class="flat-surface p-8">
          <div class="support-icon mb-4">👶</div>
          <h3 class="text-xl font-bold mb-3">On-Site Childcare Assistance</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Subsidies and dedicated childcare facilities arranged at UKABCS-sponsored offline conferences so mother scientists can present without compromise.
          </p>
        </div>

        <div class="flat-surface p-8">
          <div class="support-icon mb-4">🎧</div>
          <h3 class="text-xl font-bold mb-3">Flexible Audio Resources</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Scientific reference literature and bioinformatics protocols produced as audiobooks, enabling flexible learning during transit and daily routines.
          </p>
        </div>

        <div class="flat-surface p-8">
          <div class="support-icon mb-4">👩‍🔬</div>
          <h3 class="text-xl font-bold mb-3">Senior Women Mentors</h3>
          <p class="text-secondary text-sm leading-relaxed">
            One-to-one mentorship pairing with prominent female lab directors and professors navigating tenure, grantsmanship, and work-life harmony.
          </p>
        </div>

        <div class="flat-surface p-8">
          <div class="support-icon mb-4">⚡</div>
          <h3 class="text-xl font-bold mb-3">Time-Saving Research Credits</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Priority access to pre-configured cloud docking workflows and automated sequencing pipelines, reducing hours spent on server maintenance.
          </p>
        </div>

        <div class="flat-surface p-8">
          <div class="support-icon mb-4">💻</div>
          <h3 class="text-xl font-bold mb-3">Hybrid &amp; Remote Access</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Full virtual participation options with live interactive Q&amp;A across all UKABCS events and committee meetings.
          </p>
        </div>
      </div>

      <!-- Action Callout -->
      <div class="flat-surface p-12 max-w-3xl mx-auto text-center">
        <span class="badge-pill badge-emerald mb-3">Priority Support</span>
        <h2 class="text-2xl font-bold mb-3">Request Women in Science Aid</h2>
        <p class="text-secondary mb-8 leading-relaxed">
          Applications for childcare subsidies and mentorship are processed on a rolling, priority basis via our secure portal.
        </p>
        <a href={siteConfig.clientFlow.generalSupportForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary">
          <span>Submit Request via ClientFlow</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .py-20 { padding-top: 5rem; padding-bottom: 5rem; }
  .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
  .text-center { text-align: center; }
  .mx-auto { margin-inline: auto; }
  .max-w-3xl { max-width: 48rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); }
  .gap-6 { gap: 1.5rem; }
  .p-8 { padding: 2rem; }
  .p-12 { padding: 3rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-8 { margin-bottom: 2rem; }
  .mb-16 { margin-bottom: 4rem; }
  .text-xl { font-size: 1.25rem; }
  .text-2xl { font-size: 1.5rem; }
  .text-sm { font-size: 0.875rem; }
  .font-bold { font-weight: 700; }
  .text-secondary { color: var(--color-text-secondary); }
  .leading-relaxed { line-height: 1.7; }
  .support-icon { font-size: 2.25rem; }

  @media (max-width: 1024px) {
    .grid-3 { grid-template-columns: 1fr; }
  }
</style>
