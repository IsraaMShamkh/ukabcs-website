---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TextContentSection from '../../components/sections/TextContentSection.astro';
import SalesPromoSection from '../../components/sections/SalesPromoSection.astro';
import NumbersCounterSection from '../../components/sections/NumbersCounterSection.astro';
import NewsletterSection from '../../components/sections/NewsletterSection.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title={`Funded Projects & Awardees | ${siteConfig.publicName}`} description="Explore peer-reviewed university grant awards, capacity building projects, and graduation support recipients across international institutions.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Award Registry"
    title="Funded Projects & Awardees"
    description="Explore peer-reviewed university grant awards, capacity building projects, and graduation support recipients across international partner institutions."
    image="https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Overview Editorial Section -->
  <TextContentSection
    tag="Transparent Grant Index"
    title="University Research Grants & Capacity Building Awards"
    subtitle="Enabling AI computational drug discovery and student capacity building."
    content="UKABCS non-profit research grants are awarded through independent peer-review evaluation. Across 2025 and 2026, UKABCS has funded research teams and graduation projects across leading universities in the UK, Brazil, Sudan, Iraq, and Egypt."
    image="https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=80&w=1000&auto=format&fit=crop"
    ctaText="Explore Open Grant Calls →"
    ctaHref="/programmes-grants"
  />

  <!-- 3. Key Impact & Stats Counter -->
  <NumbersCounterSection />

  <!-- 4. Projects & Programmes Showcase -->
  <SalesPromoSection
    title="Funded University Projects & Awardees"
    subtitle="Discover complete award details, participating faculties, and research milestones."
  />

  <!-- 5. Newsletter Bulletin -->
  <NewsletterSection />

  <!-- 6. Promo CTA -->
  <PromoCTASection />
</BaseLayout>
