---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import FeaturesBentoSection from '../components/sections/FeaturesBentoSection.astro';
import GeneralSupportSection from '../components/sections/GeneralSupportSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { siteConfig } from '../config/site';

const legalDocs = [
  {
    title: "Privacy Policy & UK GDPR Compliance",
    description: "Details on how UKABCS collects, stores, and protects member and applicant personal data in accordance with UK GDPR and Data Protection Act 2018. Effective: 01 Jan 2025."
  },
  {
    title: "Terms of Use & Membership Conditions",
    description: "Rules governing access to the UKABCS website, portal submissions, partner compute credits, and membership certificate usage. Effective: 01 Jan 2025."
  },
  {
    title: "Cookie Policy & Web Analytics",
    description: "Information on essential functional cookies, analytics tracking, and privacy settings on www.ukabcs.co.uk. Effective: 01 Jan 2025."
  },
  {
    title: "Accessibility Statement",
    description: "Our commitment to ensuring digital accessibility for disabled researchers, including WCAG 2.1 AA compliance and screen reader support. Effective: 01 Jan 2025."
  }
];
---

<BaseLayout title="Policies & Legal Information | UKABCS" description="Official UKABCS privacy policy, terms of use, cookie policy, and accessibility statements.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Compliance & Legal"
    title="Policies & Legal Information"
    description="Official UKABCS privacy policy, terms of use, cookie policy, and accessibility statements."
    image="/images/legal_policies_hero.png"
  />

  <!-- 2. SectionPool Text Content Overview -->
  <TextContentSection
    tag="Legal & Data Protection"
    title="UK GDPR & Member Privacy Commitments"
    subtitle="Rigorous compliance standards safeguarding member research proposals and institutional data."
    content="UKABCS enforces strict UK GDPR and UK Data Protection Act 2018 compliance across all digital portals, grant application forms, and member registrations. Personal data and peer-review submissions are encrypted and never disclosed to third parties without explicit legal consent."
    image="/images/legal_policies_hero.png"
    ctaText="Read Complete Privacy Policy →"
    ctaHref="/policies/privacy-policy"
  />

  <!-- 3. SectionPool Bento Grid for Legal Docs -->
  <FeaturesBentoSection
    title="Official Statutory Frameworks"
    subtitle="Review the legally binding policies and terms governing UKABCS membership and digital services."
    badge="Legal Index"
    items={legalDocs}
  />

  <!-- 4. General Support Section -->
  <GeneralSupportSection />

  <!-- 5. Newsletter & Promo CTA -->
  <NewsletterSection />
  <PromoCTASection />
</BaseLayout>
