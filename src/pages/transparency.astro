---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import FeaturesBentoSection from '../components/sections/FeaturesBentoSection.astro';
import GeneralSupportSection from '../components/sections/GeneralSupportSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { getCollection } from 'astro:content';
import { FileText, ArrowRight } from 'lucide-astro';
import { siteConfig } from '../config/site';

const policies = await getCollection('policies');
---

<BaseLayout title="Transparency & Policy Index | UKABCS" description="Access UKABCS governance policies, due diligence requirements, grant allocation guidelines, and statutory reports.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Statutory Compliance"
    title="Transparency & Reports"
    description="Access UKABCS governance policies, due diligence requirements, grant allocation guidelines, and statutory annual disclosures."
    image="/images/transparency_governance_hero.png"
  />

  <!-- 2. SectionPool Text Content Overview -->
  <TextContentSection
    tag="Open Science Governance"
    title="Statutory Rules & Transparency Index"
    subtitle="Documented procedures governing grant evaluation, ethics, and non-profit operations."
    content="The UK Association for Biotechnology & Computational Science (UKABCS) operates under full statutory and ethical compliance. Every grant funding award, compute allocation, and partnership is managed under published rules aligned with UKRI guidelines and UK non-profit standards."
    image="/images/hero_hands_collaboration.jpg"
    ctaText="Explore Open Policies →"
    ctaHref="#policy-directory"
  />

  <!-- 3. Policy Index Grid (SectionPool Cards) -->
  <section class="py-16 md:py-24 bg-background border-y border-border/60" id="policy-directory">
    <div class="container mx-auto px-4 max-w-6xl space-y-10">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="badge-pill">Directory</span>
        <h2 class="text-3xl font-bold text-foreground">Governance Policies & Statutory Rules</h2>
        <p class="text-sm text-secondary">
          Official policy documents defining operational procedures, grant-making rules, financial governance, and ethical standards.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {policies.map((p) => (
          <article class="p-6 rounded-2xl bg-card border border-border/80 shadow-sm flex flex-col justify-between hover:border-primary/50 transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <FileText class="w-5 h-5 text-primary" />
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-primary/10 text-primary border border-primary/20">
                  {p.data.publicationStatus || 'PUBLISHED'}
                </span>
              </div>

              <h3 class="text-lg font-bold text-foreground hover:text-primary transition-colors">
                <a href={`/policies/${p.data.slug || p.slug}`}>{p.data.title}</a>
              </h3>

              <p class="text-xs text-secondary leading-relaxed line-clamp-3">
                {p.data.summary}
              </p>
            </div>

            <div class="pt-4 mt-6 border-t border-border/60 flex items-center justify-between text-xs">
              <span class="text-muted">Effective: {p.data.effectiveDate || '2025'}</span>
              <a
                href={`/policies/${p.data.slug || p.slug}`}
                class="btn-fluent-secondary py-1.5 px-3 text-xs"
              >
                <span>Read Policy</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Global Scientific Impact Fund (SectionPool CTA/Donation) -->
  <section class="py-16 bg-slate-900 text-white text-center border-t border-slate-800">
    <div class="container max-w-4xl mx-auto px-4 space-y-4">
      <span class="badge-pill" style="background: rgba(255, 255, 255, 0.15); color: #7dd3fc;">Philanthropic Impact</span>
      <h2 class="text-3xl font-bold">UKABCS Global Scientific Impact Fund</h2>
      <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
        Support non-profit research grants, compute allocations for developing nation scientists, open-access APC waivers, and scientific education fellowships.
      </p>
      <div class="flex justify-center gap-4 flex-wrap pt-4">
        <a href={siteConfig.clientFlow.impactFundDonationForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary">
          <span>Contribute to Global Impact Fund</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={siteConfig.clientFlow.partnershipDonationForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
          <span>Partnership &amp; Donation Form</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. General Support -->
  <GeneralSupportSection />

  <!-- 6. Newsletter & Promo CTA -->
  <NewsletterSection />
  <PromoCTASection />
</BaseLayout>
