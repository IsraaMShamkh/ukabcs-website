---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import FeaturesBentoSection from '../components/sections/FeaturesBentoSection.astro';
import GeneralSupportSection from '../components/sections/GeneralSupportSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { getCollection } from 'astro:content';
import { FileText, ArrowRight } from 'lucide-astro';
import { siteConfig } from '../config/site';

const policies = await getCollection('policies');
---

<BaseLayout title="Transparency & Policy Index | UKABCS" description="Access UKABCS governance policies, due diligence requirements, grant allocation guidelines, and statutory reports.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Statutory Compliance"
    title="Transparency & Reports"
    description="Access UKABCS governance policies, due diligence requirements, grant allocation guidelines, and statutory annual disclosures."
    image="/images/transparency_governance_hero.png"
  />

  <!-- 2. SectionPool Text Content Overview -->
  <TextContentSection
    tag="Open Science Governance"
    title="Statutory Rules & Transparency Index"
    subtitle="Documented procedures governing grant evaluation, ethics, and non-profit operations."
    content="The UK Association for Biotechnology & Computational Science (UKABCS) operates under full statutory and ethical compliance. Every grant funding award, compute allocation, and partnership is managed under published rules aligned with UKRI guidelines and UK non-profit standards."
    image="/images/hero_hands_collaboration.jpg"
    ctaText="Explore Open Policies →"
    ctaHref="#policy-directory"
  />

  <!-- 3. Policy Index Grid (SectionPool Cards) -->
  <section class="policy-directory-section" id="policy-directory">
    <div class="container policy-directory-container">
      <div class="policy-directory-heading">
        <span class="badge-pill">Directory</span>
        <h2 class="text-3xl font-bold text-foreground">Governance Policies & Statutory Rules</h2>
        <p class="text-sm text-secondary">
          Official policy documents defining operational procedures, grant-making rules, financial governance, and ethical standards.
        </p>
      </div>

      <div class="policy-directory-grid">
        {policies.map((p) => (
          <article class="policy-directory-card">
            <div class="policy-directory-card__body">
              <div class="policy-directory-card__topline">
                <FileText class="w-5 h-5 text-primary" />
                <span class="policy-directory-card__status">
                  {p.data.publicationStatus || 'PUBLISHED'}
                </span>
              </div>

              <h3 class="text-lg font-bold text-foreground hover:text-primary transition-colors">
                <a href={`/policies/${p.data.slug || p.slug}`}>{p.data.title}</a>
              </h3>

              <p class="text-xs text-secondary leading-relaxed line-clamp-3">
                {p.data.summary}
              </p>
            </div>

            <div class="policy-directory-card__footer">
              <span>Effective: {p.data.effectiveDate || '2025'}</span>
              <a
                href={`/policies/${p.data.slug || p.slug}`}
                class="btn-fluent-secondary policy-directory-card__link"
              >
                <span>Read Policy</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Global Scientific Impact Fund (SectionPool CTA/Donation) -->
  <section class="py-20 bg-slate-900 text-white text-center border-t border-slate-800">
    <div class="container max-w-4xl mx-auto px-4 space-y-4">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-semibold mb-2 border border-sky-400/30">
        Philanthropic Impact
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-white">UKABCS Global Scientific Impact Fund</h2>
      <p class="text-slate-200 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
        Support non-profit research grants, compute allocations for developing nation scientists, open-access APC waivers, and scientific education fellowships.
      </p>
      <div class="flex justify-center gap-4 flex-wrap pt-4">
        <a href={siteConfig.clientFlow.impactFundDonationForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary" style="background: #0284c7; color: #ffffff;">
          <span>Contribute to Global Impact Fund</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={siteConfig.clientFlow.partnershipDonationForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
          <span>Partnership &amp; Donation Form</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. General Support -->
  <GeneralSupportSection />

  <!-- 6. Newsletter & Promo CTA -->
  <NewsletterSection />
  <PromoCTASection />
</BaseLayout>

<style>
  .policy-directory-section {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: var(--color-bg);
    border-block: 1px solid var(--color-border);
  }

  .policy-directory-container { max-width: 1200px; }
  .policy-directory-heading { max-width: 46rem; margin: 0 auto 2.75rem; text-align: center; }
  .policy-directory-heading h2 { margin: .75rem 0; }

  .policy-directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .policy-directory-card {
    display: flex;
    min-width: 0;
    min-height: 17rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .policy-directory-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .policy-directory-card__body { display: grid; gap: .85rem; }
  .policy-directory-card__topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .policy-directory-card__status { padding: .3rem .6rem; border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent); border-radius: 999px; color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 10%, transparent); font-size: .68rem; font-weight: 800; letter-spacing: .05em; }
  .policy-directory-card h3 { font-size: 1.1rem; line-height: 1.35; }
  .policy-directory-card h3 a:hover { color: var(--color-primary); }
  .policy-directory-card__footer { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .78rem; }
  .policy-directory-card__link { padding: .5rem .75rem; font-size: .75rem; white-space: nowrap; }

  @media (max-width: 900px) {
    .policy-directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .policy-directory-grid { grid-template-columns: 1fr; }
    .policy-directory-card { min-height: auto; }
  }
</style>
