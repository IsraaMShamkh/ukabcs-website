---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { getCollection } from 'astro:content';
import { ShieldCheck, FileText, ArrowRight } from 'lucide-astro';
import { siteConfig } from '../config/site';

const policies = await getCollection('policies');
---

<BaseLayout title="Transparency & Policy Index | UKABCS" description="Access UKABCS governance policies, due diligence requirements, grant allocation guidelines, and statutory reports.">
  <!-- Hero -->
  <PageHero
    eyebrow="Statutory Compliance"
    title="Transparency & Reports"
    description="Access UKABCS governance policies, due diligence requirements, grant allocation guidelines, and statutory annual disclosures."
    image="https://images.unsplash.com/photo-1450133064473-71024230f91b?q=90&w=2200&auto=format&fit=crop"
  />

  <section class="py-16 md:py-24 bg-background border-b border-border/60">
    <div class="container mx-auto px-4 max-w-6xl space-y-10">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
          Open Governance Directory
        </span>
        <h2 class="text-3xl font-bold text-foreground">Governance Policies & Statutory Rules</h2>
        <p class="text-sm text-muted-foreground">
          UKABCS operates under full statutory and ethical compliance. Each policy document below defines our operational rules.
        </p>
      </div>

      <!-- Policy Index Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {policies.map((p) => (
          <article class="p-6 rounded-xl bg-card border border-border/80 shadow-sm flex flex-col justify-between hover:border-primary/40 transition-all group">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <FileText class="w-5 h-5 text-primary" />
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-secondary text-secondary-foreground">
                  {p.data.publicationStatus || 'PUBLISHED'}
                </span>
              </div>

              <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors">
                <a href={`/policies/${p.data.slug || p.slug}`}>{p.data.title}</a>
              </h3>

              <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">
                {p.data.summary}
              </p>
            </div>

            <div class="pt-4 mt-6 border-t border-border/60 flex items-center justify-between text-xs">
              <span class="text-muted-foreground">Effective: {p.data.effectiveDate || '2025'}</span>
              <a
                href={`/policies/${p.data.slug || p.slug}`}
                class="font-semibold text-primary inline-flex items-center gap-1 hover:underline"
              >
                <span>Read Policy</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Global Scientific Impact Fund Donation Section -->
  <section class="py-16 bg-slate-900 text-white text-center border-t border-slate-800">
    <div class="container max-w-4xl mx-auto px-4">
      <span class="badge-pill mb-3" style="background: rgba(255, 255, 255, 0.15); color: #7dd3fc;">Philanthropic Impact</span>
      <h2 class="text-3xl font-bold mb-3">UKABCS Global Scientific Impact Fund</h2>
      <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto mb-8 leading-relaxed">
        Support non-profit research grants, compute allocations for developing nation scientists, open-access APC waivers, and scientific education fellowships.
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href={siteConfig.clientFlow.impactFundDonationForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary">
          <span>Contribute to Global Scientific Impact Fund</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={siteConfig.clientFlow.partnershipDonationForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary">
          <span>Partnership &amp; Donation Form</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <NewsletterSection />
  <PromoCTASection />
</BaseLayout>
