---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { ShieldCheck, Lock, ExternalLink, ArrowRight, Tag, BookOpen, Cpu, Award, HeartPulse } from 'lucide-astro';

const pools = [
  {
    id: 'training-pool',
    title: 'Training & Educational Diplomas Pool',
    tag: 'Capacity Building & Workshops',
    icon: BookOpen,
    description: 'Specialised CADD, chemoinformatics, and bioinformatics hands-on workshops and professional diploma subsidies.',
    items: [
      {
        partnerName: 'Bioinformatics Gate',
        logo: '/partners/be7dcb13-5351-451b-921a-abd55739aea8.jpeg',
        website: 'https://bioinformaticsgate.com',
        category: 'Training',
        image: 'https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?q=80&w=800&auto=format&fit=crop',
        shortDescription: 'Certified professional diplomas and hands-on workshops in CADD, structural bioinformatics, and chemoinformatics.',
        discountValue: '25% Member Grant Subsidy',
        eligibility: 'All Active UKABCS Member Categories',
        terms: 'Discount applied automatically during diploma enrollment upon membership verification.',
        ctaLink: '/memberships#pricing',
        ctaText: 'Claim 25% Discount'
      },
      {
        partnerName: 'EBO Bio Solution (UK)',
        logo: '/partners/0e79b389-8500-4630-a8b2-a71cd8768b1d.jpeg',
        website: 'https://ebobio.co.uk',
        category: 'Training',
        image: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop',
        shortDescription: 'Hands-on computational pipeline training, Python for drug discovery, and molecular modeling bootcamps.',
        discountValue: '30% Member Subsidy',
        eligibility: 'Academic & Individual Members',
        terms: 'Free entry for top 10 UKABCS graduation grant awardees each cohort.',
        ctaLink: '/memberships#pricing',
        ctaText: 'Access Training Discount'
      }
    ]
  },
  {
    id: 'software-pool',
    title: 'Scientific Software & Compute Tools Pool',
    tag: 'Computational Infrastructure',
    icon: Cpu,
    description: 'High-performance computing workflows, molecular modeling suites, and scientific analysis tools.',
    items: [
      {
        partnerName: 'Exovion',
        logo: '/partners/Blue Purple Modern Molecule Technology Logo.jpg',
        website: 'https://exovion.com',
        category: 'Software',
        image: 'https://images.unsplash.com/photo-1507668077129-56e32842fceb?q=80&w=800&auto=format&fit=crop',
        shortDescription: 'Advanced computational biology software suite for sequence analysis and protein structure prediction.',
        discountValue: 'Free Member License Tier',
        eligibility: 'All Active Members & Partner Institutions',
        terms: 'Includes 1-year renewable academic license key for registered UKABCS members.',
        ctaLink: '/memberships#pricing',
        ctaText: 'Get Free Software License'
      }
    ]
  },
  {
    id: 'publishing-pool',
    title: 'Open-Access Publishing & APC Waivers Pool',
    tag: 'Academic Journals & Dissemination',
    icon: Award,
    description: 'Peer-reviewed open-science publication waivers and expedited peer-review support for scientific papers.',
    items: [
      {
        partnerName: 'IJBTCS Journal',
        logo: '/partners/ChatGPT Image Sep 13, 2026, 03_41_34 PM.png',
        website: 'https://ijbtcs.org',
        category: 'Publishing',
        image: 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?q=80&w=800&auto=format&fit=crop',
        shortDescription: 'International Journal of Biotechnology & Computational Science — indexed open-access peer-reviewed journal.',
        discountValue: '100% Full APC Waiver',
        eligibility: 'Corresponding Authors with Active UKABCS Membership',
        terms: 'Full waiver of Article Processing Charges (£1,200 value) upon manuscript acceptance.',
        ctaLink: '/publications',
        ctaText: 'Submit Paper with Waiver'
      }
    ]
  },
  {
    id: 'healthtech-pool',
    title: 'Health-Tech & Analytical Support Pool',
    tag: 'Bio-Data & Health Analytics',
    icon: HeartPulse,
    description: 'Specialised bio-data analytics, clinical research assistance, and health technology project support.',
    items: [
      {
        partnerName: 'Healora',
        logo: '/partners/Untitled design.png',
        website: 'https://healora.org',
        category: 'Services',
        image: 'https://images.unsplash.com/photo-1576086213369-97a306d36557?q=80&w=800&auto=format&fit=crop',
        shortDescription: 'Health-tech analytical platform and computational medicine research support services.',
        discountValue: '20% Partner Discount',
        eligibility: 'Individual & Institutional Members',
        terms: 'Applies to computational analysis contracts and health data pipeline consultations.',
        ctaLink: '/memberships#pricing',
        ctaText: 'Access Analytical Discount'
      }
    ]
  }
];
---

<BaseLayout title="Member Benefit Pools | UKABCS" description="Explore verified training, scientific software, computational collaboration and publishing offers organized into member benefit pools.">
  <PageHero
    eyebrow="Exclusive Directory"
    title="UKABCS Member Benefit Pools"
    description="Explore verified partner offers organized by domain: training diplomas, computational software, publishing APC waivers, and health-tech analytics."
    image="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=90&w=2200&auto=format&fit=crop"
  />

  <section class="benefits-pools-section py-16">
    <div class="container space-y-16 max-w-6xl mx-auto">
      <!-- Mandatory Access Callout -->
      <div class="p-5 md:p-6 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-200 flex items-start gap-4">
        <Lock class="w-6 h-6 text-amber-400 shrink-0 mt-0.5" />
        <div class="space-y-1 text-sm">
          <strong class="font-bold text-amber-300 text-base block">Mandatory Access Requirement</strong>
          <p class="leading-relaxed">
            All discounts, grant subsidies, and APC waivers listed below are exclusively available to verified UKABCS members. Active membership status is checked automatically upon enrollment or submission.
          </p>
        </div>
      </div>

      <!-- Section Pools Render Loop -->
      {pools.map((pool) => {
        const IconComp = pool.icon;
        return (
          <div id={pool.id} class="pool-block space-y-8 pt-4">
            <!-- Pool Header -->
            <div class="pool-header flex items-center justify-between pb-4 border-b border-border/80 flex-wrap gap-4">
              <div class="space-y-1">
                <span class="badge-pill mb-2">{pool.tag}</span>
                <h2 class="text-2xl md:text-3xl font-bold flex items-center gap-3 text-foreground">
                  <IconComp class="w-7 h-7 text-primary shrink-0" />
                  <span>{pool.title}</span>
                </h2>
                <p class="text-secondary text-sm max-w-2xl">{pool.description}</p>
              </div>
            </div>

            <!-- Pool Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {pool.items.map((item) => (
                <article class="flat-surface pool-card flex flex-col justify-between h-full p-0 rounded-2xl overflow-hidden border border-border group hover:border-primary/50 transition-all">
                  <!-- Card Image Banner -->
                  <div class="relative w-full h-48 overflow-hidden bg-navy">
                    <img
                      src={item.image}
                      alt={item.partnerName}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between">
                      <div class="flex items-center gap-2.5">
                        <img src={item.logo} alt={item.partnerName} class="w-9 h-9 rounded-full object-cover border-2 border-white shadow-md bg-white" />
                        <span class="text-white font-bold text-base shadow-sm">{item.partnerName}</span>
                      </div>
                      <span class="badge-pill bg-white/90 text-navy font-bold text-xs">{item.category}</span>
                    </div>
                  </div>

                  <!-- Card Body -->
                  <div class="p-6 flex-1 flex flex-col justify-between space-y-5">
                    <p class="text-secondary text-sm leading-relaxed">
                      {item.shortDescription}
                    </p>

                    <!-- Discount Highlight Box -->
                    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 space-y-1.5">
                      <div class="flex items-center gap-2 text-xs font-bold text-emerald-500">
                        <Tag class="w-4 h-4" />
                        <span>UKABCS Member Benefit</span>
                      </div>
                      <div class="text-lg font-extrabold text-emerald-400">
                        {item.discountValue}
                      </div>
                      <div class="text-xs text-secondary">
                        <strong>Eligible:</strong> {item.eligibility}
                      </div>
                    </div>

                    <p class="text-xs text-muted leading-relaxed italic">
                      ℹ️ {item.terms}
                    </p>

                    <!-- Actions -->
                    <div class="pt-4 border-t border-border/60 flex items-center justify-between gap-3">
                      {item.website && (
                        <a
                          href={item.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-fluent-secondary text-xs py-2 px-3 inline-flex items-center gap-1.5"
                        >
                          <span>Partner Site</span>
                          <ExternalLink class="w-3.5 h-3.5" />
                        </a>
                      )}
                      <a
                        href={item.ctaLink}
                        class="btn-fluent-primary text-xs py-2 px-4 inline-flex items-center gap-2 ml-auto"
                      >
                        <span>{item.ctaText}</span>
                        <ArrowRight class="w-4 h-4" />
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <PromoCTASection />
</BaseLayout>

<style>
  .benefits-pools-section { background: var(--color-bg-secondary, #f8fafc); }
  .pool-card { background: var(--color-surface, #ffffff); box-shadow: var(--shadow-sm); }
  .pool-card:hover { box-shadow: var(--shadow-md); }
</style>
