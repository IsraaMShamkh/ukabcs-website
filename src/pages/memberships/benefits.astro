---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { getCollection } from 'astro:content';
import { ShieldCheck, Lock, ExternalLink, ArrowRight, Tag, Info } from 'lucide-astro';

const benefitEntries = await getCollection('benefits');
const categories = ['All', 'Computing', 'Services', 'Publishing', 'Software', 'Training'];
---

<BaseLayout title="Member Benefits Directory | UKABCS" description="Explore verified compute allocations, APC publishing waivers, partner software discounts, and research credits available to UKABCS members.">
  <PageHero
    eyebrow="Exclusive Directory"
    title="Member Benefits & Partner Credits"
    description="Explore verified computing allocations, publication waivers, software licenses, and training resources available to active UKABCS members."
    image="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=90&w=2200&auto=format&fit=crop"
  />

  <section class="py-12 md:py-20 bg-background">
    <div class="container mx-auto px-4 max-w-6xl space-y-10">
      <!-- Permanent Mandatory Membership Callout -->
      <div class="p-4 md:p-6 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 flex items-start gap-4">
        <Lock class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" />
        <div class="space-y-1 text-xs md:text-sm">
          <strong class="font-bold text-amber-300 block text-base">Mandatory Access Requirement</strong>
          <p>
            You must be an active UKABCS member to access these offers, compute vouchers, and APC waivers. All discounts are subject to member identity verification upon application.
          </p>
        </div>
      </div>

      <!-- Header & Filter Bar -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold border border-primary/20">
          Partner Ecosystem
        </span>
        <h2 class="text-3xl font-bold text-foreground">Verified Partner & Grant Offers</h2>
        <p class="text-muted-foreground text-sm">
          Strategic collaborations with non-profit computational providers, academic software vendors, and indexed journals.
        </p>

        <!-- Category Filters -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-4" id="benefit-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 ${
                idx === 0
                  ? 'bg-primary text-primary-foreground shadow-md'
                  : 'bg-secondary text-muted-foreground hover:text-foreground hover:bg-secondary/80'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Benefits Directory Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="benefits-grid">
        {benefitEntries.map((entry) => {
          const data = entry.data;
          return (
            <article
              class="benefit-item flex flex-col justify-between h-full p-6 rounded-xl bg-card border border-border/80 shadow-sm hover:border-primary/40 transition-all duration-300 group"
              data-category={data.category}
            >
              <div class="space-y-4">
                <!-- Card Top: Partner Name Left, Category Right -->
                <div class="flex items-start justify-between gap-3 pb-3 border-b border-border/60">
                  <div class="flex items-center gap-3">
                    {data.logo ? (
                      <img
                        src={data.logo}
                        alt={data.partnerName}
                        class="w-10 h-10 rounded-full object-cover border border-border/60 shrink-0"
                      />
                    ) : (
                      <div class="w-10 h-10 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center shrink-0">
                        {data.partnerName.substring(0, 2).toUpperCase()}
                      </div>
                    )}
                    <div>
                      <h3 class="font-bold text-foreground text-sm line-clamp-1 group-hover:text-primary transition-colors">
                        {data.partnerName}
                      </h3>
                      {data.website && (
                        <a
                          href={data.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs text-muted-foreground hover:text-primary inline-flex items-center gap-1"
                        >
                          <span>Website</span>
                          <ExternalLink class="w-3 h-3" />
                        </a>
                      )}
                    </div>
                  </div>

                  <span class="px-2.5 py-1 rounded-full bg-secondary text-secondary-foreground text-xs font-semibold shrink-0">
                    {data.category}
                  </span>
                </div>

                <!-- Description & Services -->
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {data.shortDescription}
                </p>

                {data.services && data.services.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {data.services.map((service) => (
                      <span class="px-2 py-0.5 rounded bg-muted text-[11px] text-muted-foreground font-medium">
                        {service}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Highlight Box: Member Offer Only (No Contribution confusion) -->
                <div class="p-3.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 space-y-1">
                  <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-400">
                    <Tag class="w-3.5 h-3.5" />
                    <span>Member Discount / Offer</span>
                  </div>
                  <div class="text-base font-extrabold text-emerald-300">
                    {data.discountValue}
                  </div>
                  <div class="text-[11px] text-emerald-200/80">
                    Eligible: {data.eligibility}
                  </div>
                </div>

                {data.terms && (
                  <div class="text-[11px] text-muted-foreground flex items-start gap-1.5 pt-1">
                    <Info class="w-3.5 h-3.5 text-muted-foreground shrink-0 mt-0.5" />
                    <span>{data.terms}</span>
                  </div>
                )}
              </div>

              <!-- Action Bar -->
              <div class="pt-4 mt-6 border-t border-border/60 flex flex-col gap-2">
                {data.partnershipSlug && (
                  <a
                    href={`/partnerships/${data.partnershipSlug}`}
                    class="w-full py-2 px-3 rounded-lg bg-secondary hover:bg-secondary/80 text-foreground text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors"
                  >
                    <span>View Partnership Details</span>
                    <ArrowRight class="w-3.5 h-3.5" />
                  </a>
                )}
                
                <a
                  href="/memberships#pricing"
                  class="w-full py-2 px-3 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors shadow-sm"
                >
                  <ShieldCheck class="w-3.5 h-3.5" />
                  <span>Access Offer as Member</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden p-12 text-center rounded-xl bg-card border border-border/60 space-y-3">
        <Info class="w-8 h-8 text-muted-foreground mx-auto" />
        <h3 class="text-lg font-bold text-foreground">No Offers Found in this Category</h3>
        <p class="text-xs text-muted-foreground">Select another category or choose "All" to browse available benefits.</p>
      </div>
    </div>
  </section>

  <PromoCTASection />
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    setupBenefitFilters();
  });

  setupBenefitFilters();

  function setupBenefitFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('#benefit-filters button');
    const items = document.querySelectorAll<HTMLElement>('.benefit-item');
    const emptyState = document.getElementById('empty-state');

    if (!filterButtons.length || !items.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        // Update button states
        filterButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-md');
          b.classList.add('bg-secondary', 'text-muted-foreground');
        });

        btn.classList.remove('bg-secondary', 'text-muted-foreground');
        btn.classList.add('bg-primary', 'text-primary-foreground', 'shadow-md');

        // Filter items
        let visibleCount = 0;
        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (cat === 'All' || itemCat === cat) {
            item.style.display = 'flex';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        // Toggle empty state
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    });
  }
</script>
