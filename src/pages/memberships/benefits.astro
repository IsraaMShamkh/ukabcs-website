---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { getCollection } from 'astro:content';

const benefits = await getCollection('benefits');
const categoryLabels: Record<string, string> = {
  Training: 'Education & Training', Computing: 'Scientific Software & Compute', Software: 'Software & Digital Platforms', Publishing: 'Publishing & Conferences', Services: 'Analytical & Research Services',
};
const tabs = [{ id: 'all', label: 'All Benefits' }, ...Object.entries(categoryLabels).map(([category, label]) => ({ id: category.toLowerCase(), label, category }))];
---

<BaseLayout title="Partner Benefits & Discount Marketplace | UKABCS" description="Verified UKABCS member discounts and partner offers in one marketplace.">
  <PageHero eyebrow="Exclusive Member Ecosystem" title="Partner Benefits & Discount Marketplace" description="As an active UKABCS member, you receive verified partner discounts and member offers across scientific providers." image="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=90&w=2200&auto=format&fit=crop" />

  <section class="benefits-marketplace py-20" id="benefit-marketplace">
    <div class="container">
      <div class="marketplace-heading"><span class="badge-pill mb-3">Exclusive Member Ecosystem</span><h2 class="text-3xl font-bold">Partner Benefits &amp; Discount Marketplace</h2><p class="text-secondary mt-2 max-w-3xl">Browse verified member offers by category, with a clear description and direct route to each partner offer.</p></div>
      <div class="member-access-note" role="note"><strong>Member discount announcement.</strong> Active UKABCS members receive partner discounts typically ranging from 25% to 65%. Any limited-time or special partner offer will be announced separately by UKABCS.</div>

      <div class="marketplace-tabs" role="tablist" aria-label="Partner benefit categories">
        {tabs.map((tab, index) => <button class:list={['marketplace-tab', index === 0 && 'is-active']} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-category={tab.category || 'all'}>{tab.label} ({tab.category ? benefits.filter((benefit) => benefit.data.category === tab.category).length : benefits.length})</button>)}
      </div>

      <div class="marketplace-table-wrap"><table class="marketplace-table"><thead><tr><th>Verified Partner</th><th>About the offer</th><th>Discount</th><th aria-label="Action"></th></tr></thead><tbody>
        {benefits.map((benefit) => <tr data-category={benefit.data.category}><td><div class="partner-cell">{benefit.data.logo && <img src={benefit.data.logo} alt={benefit.data.partnerName} loading="lazy" />}<div><strong>{benefit.data.partnerName}</strong><span>{categoryLabels[benefit.data.category]}</span></div></div></td><td><p class="offer-description">{benefit.data.shortDescription}</p></td><td><strong class="discount-value">{benefit.data.discountValue.replace(/\s*Member Discount$/i, '')}</strong></td><td><a class="btn-fluent-primary table-action" href={`/partnerships/${benefit.data.partnershipSlug}`}>Get offer <span aria-hidden="true">→</span></a></td></tr>)}
      </tbody></table></div>
    </div>
  </section>
  <PromoCTASection />
</BaseLayout>

<style>
  .benefits-marketplace{background:var(--color-bg-secondary,#f8fafc)}.benefits-marketplace .container{width:min(95%,1440px);max-width:none}.marketplace-heading{max-width:54rem;margin:0 auto 2rem;text-align:center}.member-access-note{margin:0 auto 2rem;padding:1rem 1.25rem;color:var(--color-primary);background:var(--color-primary-soft);border:1px solid color-mix(in srgb,var(--color-primary) 25%,transparent);border-radius:var(--radius-md,8px);line-height:1.65}.marketplace-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:.45rem;border-bottom:1px solid var(--color-border);margin-bottom:1.75rem}.marketplace-tab{appearance:none;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--color-text-secondary);padding:.85rem 1rem;margin-bottom:-1px;font:inherit;font-size:.9rem;font-weight:700;cursor:pointer}.marketplace-tab:hover,.marketplace-tab.is-active{color:var(--color-primary);border-bottom-color:var(--color-primary)}.marketplace-table-wrap{overflow-x:auto;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg,12px)}.marketplace-table{width:100%;min-width:880px;border-collapse:collapse}.marketplace-table th{padding:1rem 1.25rem;text-align:left;background:var(--color-bg-secondary);color:var(--color-text-secondary);font-size:.78rem;letter-spacing:.04em;text-transform:uppercase}.marketplace-table td{padding:1.15rem 1.25rem;border-top:1px solid var(--color-border);vertical-align:middle;color:var(--color-text-secondary);font-size:.9rem;line-height:1.55}.marketplace-table tr[hidden]{display:none}.partner-cell{display:flex;align-items:center;gap:.85rem;min-width:210px}.partner-cell img{width:4rem;height:2.75rem;padding:.2rem;object-fit:contain;background:#fff;border:1px solid var(--color-border);border-radius:.45rem}.partner-cell strong{display:block;color:var(--color-text-primary);font-weight:750}.partner-cell span{display:block;margin-top:.2rem;color:var(--color-primary);font-size:.77rem;font-weight:700}.offer-description{margin:0;max-width:40rem}.discount-value{display:inline-flex;align-items:center;justify-content:center;min-width:4.5rem;color:var(--color-primary);font-size:1rem;font-weight:800}.table-action{white-space:nowrap;font-size:.82rem;padding:.65rem .9rem}@media(max-width:640px){.benefits-marketplace .container{width:95%}.marketplace-tab{padding:.7rem .55rem;font-size:.8rem}}
</style>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.marketplace-tab'));
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.marketplace-table tbody tr'));
  tabButtons.forEach((button) => button.addEventListener('click', () => { const category = button.dataset.category; tabButtons.forEach((tab) => { const active = tab === button; tab.classList.toggle('is-active', active); tab.setAttribute('aria-selected', String(active)); }); rows.forEach((row) => { row.hidden = category !== 'all' && row.dataset.category !== category; }); }));
</script>
