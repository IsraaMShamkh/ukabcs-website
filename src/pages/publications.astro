---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import PartnerRibbonSection from '../components/sections/PartnerRibbonSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`Publications & Conferences Support | ${siteConfig.publicName}`} description="UKABCS actively assists researchers with open-access publishing fees and offers travel grants for presenting at leading international biotechnology conferences.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Research Dissemination"
    title="Publications & Conferences Support"
    description="UKABCS actively assists researchers with open-access publishing fees (APC waivers) and offers travel grants for presenting at leading international biotechnology conferences."
    image="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Open-Access Publishing Support -->
  <TextContentSection
    tag="Open Access Publishing"
    title="Open-Access Article Processing Charge (APC) Waivers"
    subtitle="Removing financial barriers to international open-access dissemination."
    content="High article processing charges shouldn't prevent your discoveries from being cited. UKABCS provides full 100% and partial APC fee waivers across indexed international partner journals, ensuring your computational and biological findings are published open-access with maximum reach."
    image="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?q=80&w=1000&auto=format&fit=crop"
    ctaText="Explore Open Call Details →"
    ctaHref="/calls/journal-apc-waiver-2026"
  />

  <!-- 3. Conference Aid & Travel Stipends (Reversed) -->
  <TextContentSection
    tag="Conference & Travel Aid"
    title="International Conference Presentation Grants"
    subtitle="Presenting peer-reviewed posters and oral papers at premier symposia."
    content="Present your peer-reviewed posters and oral presentations at premier international conferences. UKABCS covers registration fees, abstract submission expenses, and international travel stipends for selected early career researchers and PhD candidates."
    image="https://images.unsplash.com/photo-1475721027785-f74eccf877e2?q=80&w=1000&auto=format&fit=crop"
    ctaText="Explore Travel Grant Call →"
    ctaHref="/calls/international-conference-travel-2026"
    reversed={true}
  />

  <!-- 4. Official Journal Partnership Callout -->
  <TextContentSection
    tag="Official Journal Collaboration"
    title="International Journal of Biotechnology & Computational Science (IJBTCS)"
    subtitle="£220,000 In-Kind Publication Allocation."
    content="In partnership with the International Journal of Biotechnology & Computational Science (IJBTCS), UKABCS provides guaranteed fast-track review and complete open-access fee waivers for papers authored by UKABCS grant awardees and active members."
    image="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?q=80&w=1000&auto=format&fit=crop"
    ctaText="Read Partnership Details →"
    ctaHref="/partnerships/ijbtcs-220k"
  />

  <!-- 5. Partner Marquee Ribbon -->
  <PartnerRibbonSection />

  <!-- 6. Newsletter Bulletin -->
  <NewsletterSection />

  <!-- 7. Promo CTA -->
  <PromoCTASection />
</BaseLayout>
