---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="Researcher Memberships | UK Association for Biotechnology & Computational Science">
  <!-- Header -->
  <section class="page-header py-20 text-center">
    <div class="container">
      <span class="badge-pill badge-emerald">Global Academic Network</span>
      <h1 class="page-title mt-4">UKABCS Researcher Memberships</h1>
      <p class="page-subtitle max-w-3xl mx-auto">
        Connect to an international consortium of biotechnology and computational scientists, access exclusive grant rounds and compute credits, while directly accelerating our non-profit open-science mission.
      </p>
    </div>
  </section>

  <!-- 4 Categories Section -->
  <section class="section-alt py-12">
    <div class="container">
      <div class="text-center mb-10">
        <span class="badge-pill">Step 1</span>
        <h2 class="mt-3">Choose Your Membership Category</h2>
      </div>

      <div class="grid-4 gap-6">
        <div class="flat-surface text-center p-8">
          <div class="cat-icon">🎓</div>
          <h3 class="cat-title">Student</h3>
          <p class="text-secondary text-sm">Undergraduate &amp; master's students pursuing biotechnology, chemistry, or bioinformatics degrees.</p>
        </div>

        <div class="flat-surface text-center p-8">
          <div class="cat-icon">🔬</div>
          <h3 class="cat-title">Early Career</h3>
          <p class="text-secondary text-sm">PhD researchers, postdocs, and young faculty within 7 years of terminal degree completion.</p>
        </div>

        <div class="flat-surface text-center p-8">
          <div class="cat-icon">🏛️</div>
          <h3 class="cat-title">Senior Researcher</h3>
          <p class="text-secondary text-sm">Principal investigators, lab directors, research professors, and senior industrial scientists.</p>
        </div>

        <div class="flat-surface text-center p-8">
          <div class="cat-icon">🌐</div>
          <h3 class="cat-title">Institutions</h3>
          <p class="text-secondary text-sm">University departments, research institutes, and scientific organizations seeking departmental access.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Membership Pricing Plans -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-16">
        <span class="badge-pill">Step 2 &amp; 3</span>
        <h2 class="mt-3">Select Your Membership Plan &amp; Register</h2>
        <p class="text-secondary mt-2">All contributions directly fund our non-profit grant awards.</p>
      </div>

      <div class="pricing-grid">
        <!-- Student Plan -->
        <div class="flat-surface pricing-card">
          <span class="badge-pill mb-4">Student Tier</span>
          <h3 class="pricing-plan-name">Student Membership</h3>
          <div class="price-val">£25 <span class="price-period">/ year</span></div>
          <p class="text-secondary text-sm mb-6">Designed specifically for undergraduates and early graduate students.</p>

          <ul class="plan-features mb-8">
            <li>✓ Eligibility for Graduation Project Grants</li>
            <li>✓ Free access to all UKABCS webinars</li>
            <li>✓ Access to scientific audiobook library</li>
            <li>✓ Digital Membership ID card &amp; certificate</li>
            <li>✓ Discord &amp; community mentorship access</li>
          </ul>

          <a href={siteConfig.clientFlow.membershipForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary w-full text-center">
            Register via ClientFlow
          </a>
        </div>

        <!-- Professional Plan (Featured) -->
        <div class="flat-surface pricing-card featured-plan">
          <div class="featured-badge">Most Popular</div>
          <span class="badge-pill badge-emerald mb-4">Professional Tier</span>
          <h3 class="pricing-plan-name">Professional Member</h3>
          <div class="price-val">£75 <span class="price-period">/ year</span></div>
          <p class="text-secondary text-sm mb-6">For postdocs, faculty, and research professionals.</p>

          <ul class="plan-features mb-8">
            <li>✓ Priority Capacity Building Grant evaluation</li>
            <li>✓ 15% discount on partner APC publications</li>
            <li>✓ Full access to industry research credit queues</li>
            <li>✓ Conference travel assistance eligibility</li>
            <li>✓ Official Member directory listing &amp; ID</li>
            <li>✓ Peer-review committee invitation eligibility</li>
          </ul>

          <a href={siteConfig.clientFlow.membershipForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary w-full text-center">
            Register via ClientFlow
          </a>
        </div>

        <!-- Premium / Institutional -->
        <div class="flat-surface pricing-card">
          <span class="badge-pill mb-4">Institutional Tier</span>
          <h3 class="pricing-plan-name">Premium / Institute</h3>
          <div class="price-val">£250 <span class="price-period">/ year</span></div>
          <p class="text-secondary text-sm mb-6">For lab groups, departments, and senior researchers.</p>

          <ul class="plan-features mb-8">
            <li>✓ Covers up to 5 research team members</li>
            <li>✓ Dedicated GPU server allocations via partners</li>
            <li>✓ Full journal APC waiver opportunities</li>
            <li>✓ Co-host webinars and workshops with UKABCS</li>
            <li>✓ Institutional logo placed on partner wall</li>
            <li>✓ Direct advisory committee liaison</li>
          </ul>

          <a href={siteConfig.clientFlow.membershipForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary w-full text-center">
            Register via ClientFlow
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- In-Kind Credits Summary -->
  <section class="section-alt py-16">
    <div class="container">
      <div class="card-aceternity p-10 max-w-4xl mx-auto">
        <h3 class="text-center mb-3" style="font-size: 1.35rem;">In-Kind Research Credits for Members</h3>
        <p class="text-secondary text-center mb-8">
          Thanks to generous philanthropic partners, all UKABCS members gain priority access to cutting-edge computing and analytical services:
        </p>

        <div class="grid-3 gap-6 text-center">
          <div class="credit-pill p-4">
            <div class="credit-value">£35,000</div>
            <div class="text-xs text-muted">Bioinformatics Gate Cloud Hours</div>
          </div>
          <div class="credit-pill p-4">
            <div class="credit-value">£150,000</div>
            <div class="text-xs text-muted">EBO Bio Solution Analytics</div>
          </div>
          <div class="credit-pill p-4">
            <div class="credit-value">£220,000</div>
            <div class="text-xs text-muted">IJBTCS Publication Waivers</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection />

  <!-- Promo CTA -->
  <PromoCTASection />
</BaseLayout>

<style>
  .cat-icon {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .cat-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  @media (max-width: 1024px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 28rem;
    }
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    position: relative;
  }

  .pricing-plan-name {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .featured-plan {
    border-color: var(--color-primary);
    border-width: 2px;
  }

  .featured-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
  }

  .price-val {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }

  .price-period {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .plan-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    flex-grow: 1;
  }

  /* Credit Pills */
  .credit-pill {
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .credit-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }
</style>
