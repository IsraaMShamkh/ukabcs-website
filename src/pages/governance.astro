---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import FeaturesBentoSection from '../components/sections/FeaturesBentoSection.astro';
import TeamSection from '../components/sections/TeamSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`Board of Trustees & Leadership | ${siteConfig.publicName}`} description="UKABCS operates under independent UK non-profit governance standards, ensuring transparency, collective decision-making, and fiduciary accountability.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Institutional Oversight"
    title="Board of Trustees & Leadership"
    description="UKABCS operates under independent non-profit governance standards, ensuring transparency, collective decision-making, and fiduciary accountability."
    image="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Governance Framework Editorial -->
  <TextContentSection
    tag="Governance Principles"
    title="Independent Academic Governance"
    subtitle="Fiduciary oversight & UK non-profit regulatory compliance."
    content="UKABCS is governed as an independent non-profit academic society. Our governance model separates executive operations from grant evaluation committees to guarantee complete scientific integrity, UKRI alignment, and unbiased funding allocations."
    image="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1000&auto=format&fit=crop"
    ctaText="Review Transparency Disclosures →"
    ctaHref="/transparency"
  />

  <!-- 3. Leadership Team (TeamSection) -->
  <TeamSection />

  <!-- 4. 5 Specialised Standing Committees (Bento Grid) -->
  <FeaturesBentoSection
    title="5 Specialised Standing Committees"
    subtitle="Guaranteeing rigorous oversight across grant evaluation, ethics, finance, EDI, and scientific advisory."
  />

  <!-- 5. Annual Reports & Legal Disclosures (Reversed) -->
  <TextContentSection
    tag="Statutory Disclosures"
    title="Annual Reports & Statutory Compliance"
    subtitle="Audited financial records and open governance rules."
    content="UKABCS annual reports, conflict of interest rules, due diligence protocols, and legal policies are freely accessible to researchers, partner universities, and regulatory bodies."
    image="https://images.unsplash.com/photo-1450133064473-71024230f91b?q=80&w=1000&auto=format&fit=crop"
    ctaText="Explore Legal & Policy Index →"
    ctaHref="/legal"
    reversed={true}
  />

  <!-- 6. Newsletter Bulletin -->
  <NewsletterSection />

  <!-- 7. Promo CTA -->
  <PromoCTASection />
</BaseLayout>
