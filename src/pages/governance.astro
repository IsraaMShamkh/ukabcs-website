---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Governance & Leadership | UK Association for Biotechnology & Computational Science">
  <section class="page-header py-20 text-center">
    <div class="container">
      <span class="badge-pill badge-emerald">Institutional Standards</span>
      <h1 class="page-title mt-4">Governance &amp; Leadership</h1>
      <p class="page-subtitle max-w-3xl mx-auto">
        UKABCS operates under the highest UK non-profit governance standards, ensuring transparency, collective decision-making, and fiduciary accountability across all operations.
      </p>
    </div>
  </section>

  <!-- Organisational Structure -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-16">
        <span class="badge-pill">Framework</span>
        <h2 class="text-3xl font-bold mt-2">Our Governance Hierarchy</h2>
        <p class="text-secondary mt-2">UKRI-aligned oversight guaranteeing integrity in every awarded penny.</p>
      </div>

      <div class="grid-2 gap-8 mb-16">
        <div class="flat-surface p-10">
          <h3 class="text-2xl font-bold mb-3 text-primary">Board of Trustees</h3>
          <p class="text-secondary leading-relaxed mb-4">
            Sets overall strategic direction, ratifies organizational policies, and ensures full statutory and ethical compliance with UK law and non-profit regulations. Reviews quarterly performance, audits financial balances, and maintains institutional solvency.
          </p>
          <div class="tag-row">
            <span class="badge-pill">Fiduciary Duty</span>
            <span class="badge-pill">Legal Oversight</span>
          </div>
        </div>

        <div class="flat-surface p-10">
          <h3 class="text-2xl font-bold mb-3 text-primary">Managing Director &amp; Secretariat</h3>
          <p class="text-secondary leading-relaxed mb-4">
            Implements the Board's strategic resolutions and directs executive operations. Coordinates committee secretariats, manages partner liaisons, and administers daily grant operations and communication channels.
          </p>
          <div class="tag-row">
            <span class="badge-pill">Executive Delivery</span>
            <span class="badge-pill">Operational Compliance</span>
          </div>
        </div>
      </div>

      <!-- 5 Specialized Committees -->
      <div class="text-center mb-12">
        <span class="badge-pill">Collective Leadership</span>
        <h2 class="text-3xl font-bold mt-2">5 Specialized Standing Committees</h2>
      </div>

      <div class="grid-3 gap-6 mb-16">
        <div class="flat-surface p-8">
          <div class="comm-num">01</div>
          <h3 class="text-xl font-bold mb-2">Audit &amp; Finance Committee</h3>
          <p class="text-secondary text-sm leading-relaxed">Oversees budget controls, independent annual audits, financial risk modeling, and transparent accounting of all cash and in-kind grants.</p>
        </div>

        <div class="flat-surface p-8">
          <div class="comm-num">02</div>
          <h3 class="text-xl font-bold mb-2">Grants Review Committee</h3>
          <p class="text-secondary text-sm leading-relaxed">Manages the double-blind peer-review mechanism, panelist selection, proposal scoring matrices, and post-award milestone monitoring.</p>
        </div>

        <div class="flat-surface p-8">
          <div class="comm-num">03</div>
          <h3 class="text-xl font-bold mb-2">Ethics &amp; EDI Committee</h3>
          <p class="text-secondary text-sm leading-relaxed">Guarantees bioethical compliance, data privacy adherence (GDPR), and champions equality, diversity, and inclusion benchmarks across all calls.</p>
        </div>

        <div class="flat-surface p-8">
          <div class="comm-num">04</div>
          <h3 class="text-xl font-bold mb-2">Advisory Committee</h3>
          <p class="text-secondary text-sm leading-relaxed">Comprising senior international scientists and bioinformatics pioneers who advise the Board on emerging therapeutic and computational frontiers.</p>
        </div>

        <div class="flat-surface p-8">
          <div class="comm-num">05</div>
          <h3 class="text-xl font-bold mb-2">Partnership Committee</h3>
          <p class="text-secondary text-sm leading-relaxed">Evaluates prospective institutional MOUs, industry sponsorships, and cloud credit donations ensuring alignment with non-profit goals.</p>
        </div>

        <div class="flat-surface p-8 info-card">
          <h3 class="text-xl font-bold mb-2 text-accent">UKRI Standards Alignment</h3>
          <p class="text-secondary text-sm leading-relaxed">All committee processes mirror the UK Research and Innovation (UKRI) governance framework for fair, unbiased scientific evaluation.</p>
        </div>
      </div>

      <!-- Annual Report Banner -->
      <div class="flat-surface p-10 max-w-4xl mx-auto text-center">
        <span class="badge-pill badge-emerald mb-3">Statutory Transparency</span>
        <h3 class="text-2xl font-bold mb-3">Annual Reports &amp; Disclosures</h3>
        <p class="text-secondary mb-6 leading-relaxed">
          The official Inaugural UKABCS Annual Report &amp; Governance Dossier (2025/2026) is prepared in accordance with UK reporting standards and is freely accessible to the public and regulatory bodies.
        </p>
        <a href="/transparency" class="btn-fluent-secondary">
          <span>Review Transparency Policies</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .py-20 { padding-top: 5rem; padding-bottom: 5rem; }
  .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
  .text-center { text-align: center; }
  .mx-auto { margin-inline: auto; }
  .max-w-3xl { max-width: 48rem; }
  .max-w-4xl { max-width: 56rem; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); }
  .gap-8 { gap: 2rem; }
  .gap-6 { gap: 1.5rem; }
  .p-10 { padding: 2.5rem; }
  .p-8 { padding: 2rem; }
  .mt-2 { margin-top: 0.5rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-2 { margin-bottom: 0.5rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-6 { margin-bottom: 1.5rem; }
  .mb-12 { margin-bottom: 3rem; }
  .mb-16 { margin-bottom: 4rem; }
  .text-xl { font-size: 1.25rem; }
  .text-2xl { font-size: 1.5rem; }
  .text-3xl { font-size: 1.875rem; }
  .text-sm { font-size: 0.875rem; }
  .font-bold { font-weight: 700; }
  .text-primary { color: var(--color-primary); }
  .text-accent { color: var(--color-accent); }
  .text-secondary { color: var(--color-text-secondary); }
  .leading-relaxed { line-height: 1.7; }

  .comm-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    opacity: 0.35;
    margin-bottom: 0.5rem;
  }

  .tag-row {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 1024px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
  }
</style>
