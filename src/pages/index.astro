---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeContent } from '../config/home';
import FeaturesBentoSection from '../components/sections/FeaturesBentoSection.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import SalesPromoSection from '../components/sections/SalesPromoSection.astro';
import ArticlesBlogEventsSection from '../components/sections/ArticlesBlogEventsSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import NumbersCounterSection from '../components/sections/NumbersCounterSection.astro';
import GeneralSupportSection from '../components/sections/GeneralSupportSection.astro';
import DonationSection from '../components/sections/DonationSection.astro';
import PartnerRibbonSection from '../components/sections/PartnerRibbonSection.astro';
import Modal from '../components/ui/Modal.astro';
---

<BaseLayout title="UKABCS | UK Organisation for Biotechnology and Computational Science">
  <section class="home-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="hero-eyebrow">{homeContent.hero.eyebrow}</span>
      <h1 class="hero-title">{homeContent.hero.title}</h1>
      <p class="hero-subtitle">{homeContent.hero.description}</p>
      <div class="hero-cta-group">
        <a href="/programmes-grants" class="btn-fluent-primary">Explore programmes &amp; grants <span aria-hidden="true">→</span></a>
        <a href="/memberships" class="btn-fluent-secondary">Become a member</a>
      </div>
    </div>
  </section>

  <TextContentSection {...homeContent.welcome} ctaText="Discover UKABCS" ctaHref="/about-us" />
  <TextContentSection {...homeContent.membership} ctaText="Explore membership" ctaHref="/memberships" reversed />
  <TextContentSection {...homeContent.mission} ctaText="About our work" ctaHref="/about-us" />
  <TextContentSection {...homeContent.vision} ctaText="Explore UKABCS" ctaHref="/about-us" reversed />
  <FeaturesBentoSection />
  <PromoCTASection title="Join our community" subtitle="Researchers, universities, institutions and industry partners can collaborate with UKABCS to turn research ideas into meaningful outcomes." primaryBtnText="Explore partnerships" primaryBtnHref="/partnerships" secondaryBtnText="Explore memberships" secondaryBtnHref="/memberships" />
  <SalesPromoSection />
  <NumbersCounterSection />
  <GeneralSupportSection />
  <DonationSection />
  <ArticlesBlogEventsSection limit={3} />
  <PartnerRibbonSection />
  <PromoCTASection
    title="Ready to join UKABCS?"
    subtitle="Join a growing international community working to advance biotechnology and computational science."
    primaryBtnText="Apply for Membership"
    primaryBtnHref="/memberships"
    secondaryBtnText="Join as a Partner"
    secondaryBtnHref="/partnerships"
    tertiaryBtnText="Contact Us"
    tertiaryBtnHref="#contact"
  />
  <Modal />
</BaseLayout>

<style>
  .home-hero {
    min-height: calc(100svh - 5rem);
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: var(--color-navy);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=90&w=2200&auto=format&fit=crop') center / cover;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: rgba(8, 17, 31, 0.82);
  }

  .hero-grid { position:absolute; inset:0; z-index:-1; opacity:.24; background-image:linear-gradient(rgba(255,255,255,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.18) 1px,transparent 1px); background-size:50px 50px; }
  .hero-content { padding-top:7rem; padding-bottom:7rem; max-width:1600px; }
  .hero-eyebrow { display:inline-block; max-width:43rem; font-size:.8rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; color:#c9efff; }
  .hero-title { margin-top:1rem; max-width:55rem; color:#fff; font-size:clamp(4rem,11vw,9rem); font-weight:850; line-height:.88; letter-spacing:-.075em; text-shadow:0 3px 22px rgba(0,0,0,.34); }
  .hero-subtitle { margin-top:1.75rem; max-width:43rem; color:#f4f8fc; font-size:clamp(1.08rem,1.7vw,1.38rem); line-height:1.65; text-shadow:0 2px 14px rgba(0,0,0,.35); }
  .hero-cta-group { margin-top:2.5rem; display:flex; gap:.9rem; flex-wrap:wrap; }
  .home-hero .btn-fluent-primary { background:#fff; color:var(--color-primary); box-shadow:0 12px 28px rgba(0,0,0,.18); }
  .home-hero .btn-fluent-primary:hover { background:#eaf6fd; }
  .home-hero .btn-fluent-secondary { color:#fff; border-color:rgba(255,255,255,.72); background:rgba(255,255,255,.08); }
  .home-hero .btn-fluent-secondary:hover { background:rgba(255,255,255,.16); border-color:#fff; }
  .section-text-content .text-primary-color { color:var(--color-primary); }
  @media(max-width:720px){.home-hero{min-height:calc(100svh - 5rem)}.hero-content{padding-top:5rem;padding-bottom:5rem}.hero-title{font-size:clamp(3.7rem,18vw,5.8rem)}.hero-grid{mask-image:none}.home-hero::before{background-position:64% center}}
</style>
