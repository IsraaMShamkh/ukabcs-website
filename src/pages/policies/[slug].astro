---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import NewsletterSection from '../../components/sections/NewsletterSection.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import TextContentSection from '../../components/sections/TextContentSection.astro';
import FeaturesBentoSection from '../../components/sections/FeaturesBentoSection.astro';
import { getCollection } from 'astro:content';
import { Download } from 'lucide-astro';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((policy) => ({
    params: { slug: policy.data.slug || policy.slug },
    props: { policy },
  }));
}

const { policy } = Astro.props;
const { Content } = await policy.render();
const data = policy.data;
const policyDetails = [
  { title: 'Publication status', description: data.publicationStatus || 'PUBLISHED' },
  { title: 'Effective date', description: data.effectiveDate || 'To be confirmed' },
  { title: 'Next review', description: data.reviewDate || 'Reviewed periodically' },
];
---

<BaseLayout title={`${data.title} | UKABCS Policy`} description={data.summary}>
  <!-- Hero -->
  <PageHero
    eyebrow="Governance & Compliance"
    title={data.title}
    description={data.summary}
    image="/images/legal_policies_hero.png"
  />

  <TextContentSection
    tag="Official policy"
    title="Policy overview"
    subtitle={data.summary}
    content="This policy forms part of the UKABCS governance and compliance framework. Its status, effective date, and review schedule are recorded below."
    image="/images/legal_policies_hero.png"
    ctaText="Back to the Policy Directory"
    ctaHref="/transparency#policy-directory"
  />

  <FeaturesBentoSection
    sectionId="policy-details"
    badge="Document record"
    title="Policy details"
    subtitle="The current publication and review information for this official UKABCS policy."
    items={policyDetails}
  />

  <!-- Main Body -->
  <section class="py-16 bg-background policy-reading-section">
    <div class="container mx-auto px-4 max-w-4xl space-y-12">
      <article class="policy-reading-card prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-primary leading-relaxed">
        <Content />
      </article>

      {data.download && (
        <div class="p-6 rounded-xl bg-card border border-border/80 flex items-center justify-between gap-4">
          <div>
            <h4 class="font-bold text-foreground text-sm">Download Official Document</h4>
            <p class="text-xs text-muted-foreground">Download official signed PDF copy of this policy document.</p>
          </div>
          <a
            href={data.download}
            target="_blank"
            rel="noopener noreferrer"
            class="py-2 px-4 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-xs font-semibold inline-flex items-center gap-1.5 transition-colors shrink-0"
          >
            <Download class="w-3.5 h-3.5" />
            <span>Download PDF</span>
          </a>
        </div>
      )}

      <div class="pt-6 border-t border-border/60">
        <a
          href="/transparency"
          class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
        >
          <span>← Back to Transparency & Policy Index</span>
        </a>
      </div>
    </div>
  </section>

  <NewsletterSection />
  <PromoCTASection />
</BaseLayout>

<style>
  .policy-reading-card {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .policy-reading-card :global(h1) {
    font-size: clamp(1.7rem, 3vw, 2.25rem);
    margin-top: 0;
  }
</style>
