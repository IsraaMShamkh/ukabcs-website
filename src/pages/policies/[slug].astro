---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import NewsletterSection from '../../components/sections/NewsletterSection.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { getCollection } from 'astro:content';
import { ShieldCheck, Calendar, Download, ArrowRight } from 'lucide-astro';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((policy) => ({
    params: { slug: policy.data.slug || policy.slug },
    props: { policy },
  }));
}

const { policy } = Astro.props;
const { Content } = await policy.render();
const data = policy.data;
---

<BaseLayout title={`${data.title} | UKABCS Policy`} description={data.summary}>
  <!-- Hero -->
  <PageHero
    eyebrow="Governance & Compliance"
    title={data.title}
    description={data.summary}
    image="/images/legal_policies_hero.png"
  />

  <!-- Meta Summary Bar -->
  <section class="py-6 bg-card border-b border-border/60">
    <div class="container mx-auto px-4 max-w-4xl flex items-center justify-between text-xs text-muted-foreground flex-wrap gap-4">
      <div class="flex items-center gap-4">
        {data.effectiveDate && (
          <div class="flex items-center gap-1.5">
            <Calendar class="w-4 h-4 text-primary shrink-0" />
            <span>Effective Date: <strong>{data.effectiveDate}</strong></span>
          </div>
        )}
        {data.reviewDate && (
          <div class="flex items-center gap-1.5">
            <ShieldCheck class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Next Review: <strong>{data.reviewDate}</strong></span>
          </div>
        )}
      </div>

      <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
        {data.publicationStatus || 'PUBLISHED'}
      </span>
    </div>
  </section>

  <!-- Main Body -->
  <section class="py-16 bg-background">
    <div class="container mx-auto px-4 max-w-4xl space-y-12">
      <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-primary leading-relaxed">
        <Content />
      </article>

      {data.download && (
        <div class="p-6 rounded-xl bg-card border border-border/80 flex items-center justify-between gap-4">
          <div>
            <h4 class="font-bold text-foreground text-sm">Download Official Document</h4>
            <p class="text-xs text-muted-foreground">Download official signed PDF copy of this policy document.</p>
          </div>
          <a
            href={data.download}
            target="_blank"
            rel="noopener noreferrer"
            class="py-2 px-4 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-xs font-semibold inline-flex items-center gap-1.5 transition-colors shrink-0"
          >
            <Download class="w-3.5 h-3.5" />
            <span>Download PDF</span>
          </a>
        </div>
      )}

      <div class="pt-6 border-t border-border/60">
        <a
          href="/transparency"
          class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
        >
          <span>← Back to Transparency & Policy Index</span>
        </a>
      </div>
    </div>
  </section>

  <NewsletterSection />
  <PromoCTASection />
</BaseLayout>
