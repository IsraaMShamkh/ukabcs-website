---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import TextContentSection from '../components/sections/TextContentSection.astro';
import FeaturesBentoSection from '../components/sections/FeaturesBentoSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`Events & Educational Support | ${siteConfig.publicName}`} description="UKABCS offers fully-subsidized diploma courses, scientific audiobooks, student competitions, and research mentorship for biotechnology scholars.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Capacity Development"
    title="Events & Educational Support"
    description="UKABCS offers fully-subsidized diploma courses, scientific audiobooks, student competitions, and research mentorship for biotechnology scholars."
    image="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Non-Financial Training & Course Support -->
  <TextContentSection
    tag="Certified Training"
    title="Professional Diploma in Chemoinformatics & CADD"
    subtitle="Fully-subsidized 14-module interactive online diploma course."
    content="Access certified CADD online diplomas, Python for bioinformatics video modules, scientific audiobook libraries, and automated Google Colab analysis scripts. All educational assets are provided free or fully-subsidized for verified academic students."
    image="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1000&auto=format&fit=crop"
    ctaText="Explore Diploma Course Call →"
    ctaHref="/calls/chemoinformatics-diploma-course"
  />

  <!-- 3. Financial Graduation & Competition Grants (Reversed) -->
  <TextContentSection
    tag="Student Research Grants"
    title="Graduation Project & Student Competition Support"
    subtitle="Institutional support for BSc and MSc graduation research teams."
    content="UKABCS provides direct grant funding for undergraduate and postgraduate graduation projects across partner universities in the UK and internationally. Winning teams receive research software packages, publication support, and travel awards."
    image="https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1000&auto=format&fit=crop"
    ctaText="Explore Graduation Project Grant →"
    ctaHref="/news/ukabcs-graduation-project-grant-2026"
    reversed={true}
  />

  <!-- 4. Educational Tracks (Bento Grid) -->
  <FeaturesBentoSection
    title="Educational Resources & Mentorship Tracks"
    subtitle="Empowering early-career scholars with practical learning tools and 1-on-1 academic guidance."
  />

  <!-- 5. Newsletter Bulletin -->
  <NewsletterSection />

  <!-- 6. Promo CTA -->
  <PromoCTASection />
</BaseLayout>
