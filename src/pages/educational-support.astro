---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="Events & Educational Support | UK Association for Biotechnology & Computational Science">
  <section class="page-header py-20 text-center">
    <div class="container">
      <span class="badge-pill badge-emerald">Continuous Learning</span>
      <h1 class="page-title mt-4">Events &amp; Educational Support</h1>
      <p class="page-subtitle max-w-3xl mx-auto">
        Empowering researchers, postgraduates, and students through non-financial educational programs, subsidized courses, open-access audiobooks, and specialized mentorship.
      </p>
    </div>
  </section>

  <!-- Two Pillars: Non-Financial & Financial -->
  <section class="py-16">
    <div class="container">
      <div class="grid-2 gap-8 mb-16">
        <!-- Pillar 1 -->
        <div class="flat-surface p-10">
          <span class="badge-pill mb-4">Capacity Development</span>
          <h2 class="text-2xl font-bold mb-4">Non-Financial Support</h2>
          <p class="text-secondary text-sm mb-6 leading-relaxed">
            Hands-on learning and professional development designed to bridge skill gaps in modern computational biology.
          </p>
          <ul class="support-list">
            <li>📚 <strong>Specialized Training Workshops:</strong> Regular live webinars in molecular docking, QSAR, and bioinformatics pipelines.</li>
            <li>📖 <strong>Curated Scientific Book Club:</strong> Critical literature discussion groups breaking down foundational papers and books.</li>
            <li>🎧 <strong>Audiobook Access:</strong> Complex computational biology and chemoinformatics references adapted into accessible audio formats.</li>
            <li>👥 <strong>One-to-One Mentorship:</strong> Direct pairing with international researchers for career and dissertation advising.</li>
          </ul>
        </div>

        <!-- Pillar 2 -->
        <div class="flat-surface p-10">
          <span class="badge-pill badge-emerald mb-4">Funding &amp; Aid</span>
          <h2 class="text-2xl font-bold mb-4">Financial Support &amp; Scholarships</h2>
          <p class="text-secondary text-sm mb-6 leading-relaxed">
            Eliminating economic hurdles to enable equitable attendance and knowledge acquisition.
          </p>
          <ul class="support-list">
            <li>🎓 <strong>Tuition &amp; Training Scholarships:</strong> Full or partial waivers for accredited bioinformatics certifications.</li>
            <li>✈️ <strong>Conference Travel Assistance:</strong> Travel stipends and registration subsidies for international symposiums.</li>
            <li>🏆 <strong>Research Competition Prizes:</strong> Cash and compute credit awards for exceptional student innovation challenges.</li>
            <li>💳 <strong>Membership Fee Waivers:</strong> Complete membership subsidies for researchers facing financial hardship.</li>
          </ul>
        </div>
      </div>

      <!-- Educational Open Calls -->
      <div class="text-center mb-12">
        <span class="badge-pill">Immediate Access</span>
        <h2 class="text-3xl font-bold mt-2">Active Educational Open Calls</h2>
      </div>

      <div class="grid-3 gap-6 max-w-5xl mx-auto">
        <div class="flat-surface p-8">
          <span class="badge-pill badge-emerald mb-3">Free Course</span>
          <h3 class="text-lg font-bold mb-2">Intro to Chemoinformatics &amp; Drug Discovery (Arabic)</h3>
          <p class="text-secondary text-xs mb-6">Comprehensive foundational training covering ligand-receptor interactions, docking, and ADMET modeling.</p>
          <a href={siteConfig.clientFlow.generalSupportForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary text-xs w-full text-center">Enroll via Portal</a>
        </div>

        <div class="flat-surface p-8">
          <span class="badge-pill badge-emerald mb-3">Free Course</span>
          <h3 class="text-lg font-bold mb-2">Intro to Chemoinformatics &amp; Drug Discovery (English)</h3>
          <p class="text-secondary text-xs mb-6">English edition of our signature computational drug discovery curriculum for international students.</p>
          <a href={siteConfig.clientFlow.generalSupportForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary text-xs w-full text-center">Enroll via Portal</a>
        </div>

        <div class="flat-surface p-8">
          <span class="badge-pill mb-3">Audio Library</span>
          <h3 class="text-lg font-bold mb-2">Scientific Audiobook Program (Bilingual)</h3>
          <p class="text-secondary text-xs mb-6">Access curated audiobooks and lecture transcripts covering biotechnology and data science.</p>
          <a href={siteConfig.clientFlow.generalSupportForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary text-xs w-full text-center">Request Access</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .py-20 { padding-top: 5rem; padding-bottom: 5rem; }
  .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
  .text-center { text-align: center; }
  .mx-auto { margin-inline: auto; }
  .max-w-3xl { max-width: 48rem; }
  .max-w-5xl { max-width: 64rem; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); }
  .gap-8 { gap: 2rem; }
  .gap-6 { gap: 1.5rem; }
  .p-10 { padding: 2.5rem; }
  .p-8 { padding: 2rem; }
  .mt-2 { margin-top: 0.5rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-2 { margin-bottom: 0.5rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-6 { margin-bottom: 1.5rem; }
  .mb-12 { margin-bottom: 3rem; }
  .mb-16 { margin-bottom: 4rem; }
  .text-lg { font-size: 1.125rem; }
  .text-2xl { font-size: 1.5rem; }
  .text-3xl { font-size: 1.875rem; }
  .text-sm { font-size: 0.875rem; }
  .text-xs { font-size: 0.8rem; }
  .font-bold { font-weight: 700; }
  .text-secondary { color: var(--color-text-secondary); }
  .leading-relaxed { line-height: 1.7; }
  .w-full { width: 100%; }

  .support-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
  }
</style>
