---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GrantAttachments from '../../components/ui/GrantAttachments.astro';
import NewsletterSection from '../../components/sections/NewsletterSection.astro';
import Modal from '../../components/ui/Modal.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const newsItems = await getCollection('news');
  return newsItems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const heroImage = item.data.image || "https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?q=80&w=1200&auto=format&fit=crop";
const isPartnerArticle = item.data.category === 'Partnerships';
const isClosedCall = item.data.status === 'closed' || item.data.contentType === 'open-call' && item.data.status === 'closed';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": item.data.title,
  "datePublished": item.data.datePublished,
  "description": item.data.description,
  "author": {
    "@type": "Organization",
    "name": item.data.author
  },
  "publisher": {
    "@type": "NGO",
    "name": "UK Association for Biotechnology & Computational Science",
    "url": "https://www.ukabcs.co.uk"
  }
};
---

<BaseLayout title={`${item.data.title} | UKABCS Article`} description={item.data.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} slot="head" />

  <article class="py-16">
    <div class="container-narrow">
      <!-- Breadcrumb Nav -->
      <a href="/news" class="back-link mb-6 inline-flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Articles &amp; News</span>
      </a>

      <!-- Article Header Meta -->
      <header class="mb-8">
        <div class="meta-row mb-4">
          <span class="badge-pill">{item.data.category}</span>
          <time class="meta-text" datetime={item.data.datePublished}>
            {new Date(item.data.datePublished).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <span class="meta-author">By {item.data.author}</span>
        </div>

        <h1 class="article-title">{item.data.title}</h1>
        <p class="article-subtitle">{item.data.description}</p>
      </header>

      <!-- Featured Image Banner -->
      <div class:list={['article-hero-image', 'mb-10', isPartnerArticle && 'article-hero-logo']}>
        <img src={heroImage} alt={item.data.title} loading="eager" />
      </div>

      <!-- Main Article Body (Calm reading surface, no card-hover effect) -->
      <div class="article-reading-surface p-8 mb-10 prose-content">
        <Content />
      </div>

      <!-- Official Grant Attachments & Application Dossier (if present) -->
      {item.data.attachments && item.data.attachments.length > 0 && (
        <GrantAttachments items={item.data.attachments} />
      )}

      <!-- Official Application & Action Section (سيكشن التقديم جوه المقالة) -->
      <div class="article-cta-box flat-surface p-8 text-center mt-12 space-y-4" id="article-application-section">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
          <span>🎓 UKABCS Grant &amp; Research Portal</span>
        </div>
        <h3 class="text-xl md:text-2xl font-bold text-foreground">Apply for Grant Funding &amp; Capacity Building</h3>
        <p class="text-secondary text-sm max-w-2xl mx-auto">
          UKABCS provides competitive peer-reviewed research grants, publication fee waivers, and international mobility support for computational researchers.
        </p>

        <div class="flex-center gap-4 pt-2">
          {isClosedCall ? (
            <button
              type="button"
              class="btn-fluent-primary text-sm font-bold shadow-md cursor-pointer border-none"
              onclick={`window.openClosedCallModal && window.openClosedCallModal("${item.data.title.replace(/"/g, '&quot;')}")`}
            >
              <span>Submit Application — Call Closed 🔒</span>
            </button>
          ) : (
            <a
              href={siteConfig.clientFlow.innoFundGrantForm}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-fluent-primary text-sm font-bold shadow-md"
            >
              <span>Submit Grant Application Now →</span>
            </a>
          )}
          <a href={siteConfig.clientFlow.generalSupportForm} target="_blank" rel="noopener noreferrer" class="btn-fluent-secondary text-sm">
            <span>General Inquiry Form</span>
          </a>
        </div>
      </div>
    </div>
  </article>

  <NewsletterSection />
  <Modal />
</BaseLayout>

<style>
  .back-link {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform var(--transition-fast);
  }

  .back-link:hover {
    transform: translateX(-3px);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .meta-text, .meta-author {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .article-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .article-subtitle {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .article-hero-image {
    width: 100%;
    max-height: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .article-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero-logo {
    background: #ffffff;
  }

  .article-hero-logo img {
    object-fit: contain;
    padding: 1.5rem;
  }

  .article-reading-surface {
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .prose-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.92rem;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
  }

  .prose-content :global(th), .prose-content :global(td) {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border, #e2e8f0);
    text-align: left;
  }

  .prose-content :global(th) {
    background: var(--color-bg-secondary, #f8fafc);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(p) {
    margin-bottom: 1.25rem;
    color: var(--color-text-secondary);
  }

  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--color-text-secondary);
  }

  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    margin-block: 1.5rem;
    font-style: italic;
    color: var(--color-text-primary);
  }

  .flex-center {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
