---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import TextContentSection from '../../components/sections/TextContentSection.astro';
import ArticlesBlogEventsSection from '../../components/sections/ArticlesBlogEventsSection.astro';
import NewsletterSection from '../../components/sections/NewsletterSection.astro';
import PromoCTASection from '../../components/sections/PromoCTASection.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout title={`News & Research Insights | ${siteConfig.publicName}`} description="Official UKABCS announcements, open-access research articles, grant call releases, and community updates.">
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Communications & Insights"
    title="News & Research Insights Hub"
    description="Official UKABCS announcements, open-access research articles, grant call releases, and community updates."
    image="https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=90&w=2200&auto=format&fit=crop"
  />

  <!-- 2. Overview Editorial -->
  <TextContentSection
    tag="Single Source of Truth"
    title="Articles, Grant Announcements & Society News"
    subtitle="Staying informed on peer-reviewed research papers and community updates."
    content="The UKABCS News & Insights Hub publishes open-access research summaries, official grant call dossiers, annual governance reports, and partnership announcements."
    image="https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=1000&auto=format&fit=crop"
    ctaText="Subscribe to Official Bulletin ↓"
    ctaHref="#newsletter-form"
  />

  <!-- 3. Source-Driven Articles, News & Calls Tabs -->
  <ArticlesBlogEventsSection />

  <!-- 4. Newsletter Section -->
  <NewsletterSection />

  <!-- 5. Promo CTA Section -->
  <PromoCTASection />
</BaseLayout>
