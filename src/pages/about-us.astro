---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/hero/PageHero.astro';
import PromoCTASection from '../components/sections/PromoCTASection.astro';
import { siteConfig } from '../config/site';

const values = [['Excellence', 'We support rigorous, reproducible work and thoughtful peer review.'], ['Equity & inclusion', 'Opportunity should not depend on geography, background, or access to resources.'], ['Transparency', 'Funding decisions, governance, and reporting remain clear and accountable.'], ['Collaboration', 'We connect researchers, institutions, industry, and communities across borders.'], ['Innovation', 'We help practical science move from promising ideas to useful research capability.'], ['Sustainability', 'Our programmes build durable skills, networks, and research capacity.']];
const priorities = [['01', 'Build global research capacity', 'Create equitable routes to training, computing resources, mentoring, and international research networks.'], ['02', 'Provide competitive research grants', 'Support high-potential projects through transparent, peer-reviewed grant calls.'], ['03', 'Offer continuous education', 'Deliver accessible courses, workshops, conferences, and professional development.'], ['04', 'Promote open scientific publishing', 'Advance open access, reproducibility, and useful scientific knowledge.'], ['05', 'Strengthen cross-sector partnerships', 'Bring universities, research centres, industry, and funders into productive collaboration.']];
---

<BaseLayout title={`About Us | ${siteConfig.publicName}`} description="How UKABCS connects research, education, industry, and open science.">
  <PageHero eyebrow="About UKABCS" title="Connecting Research, Education & Industry" description="A global academic society building practical pathways for scientific research, capacity building, transparent funding, and open collaboration." image="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?q=85&w=2200&auto=format&fit=crop" />

  <section class="intro section-space"><div class="container intro__grid"><p class="intro__statement">Science advances further when researchers can access the resources, networks, and trust needed to do their best work.</p><div class="intro__copy"><p>{siteConfig.publicName} is a UK-registered non-profit academic society. We work at the meeting point of universities, research centres, industry, and the wider scientific community.</p><p>Through funding, education, publishing, conferences, and international collaboration, UKABCS helps turn scientific potential into sustained research capability.</p></div></div></section>

  <section class="vision section-space section-alt"><div class="container vision__grid"><div class="vision__image" role="img" aria-label="Researchers working together in a laboratory"></div><div class="vision__content"><p class="section-kicker">Our direction</p><h2>Vision and mission, held in balance.</h2><div class="vision__pair"><div><h3>Our vision</h3><p>To be an international home for equitable, data-driven scientific progress—where researchers can access high-quality resources, peer-reviewed support, and an open community.</p></div><div><h3>Our mission</h3><p>To advance biotechnology and computational science through transparent funding, specialist education, open science, and partnerships that address real global challenges.</p></div></div></div></div></section>

  <section class="section-space"><div class="container"><div class="section-heading"><p class="section-kicker">How we work</p><h2>Values that shape every programme.</h2></div><div class="values-grid">{values.map(([title, text], index) => <article class:list={["value", { "value--feature": index === 0 }]}><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="priorities section-space"><div class="container priorities__grid"><div class="priorities__intro"><p class="section-kicker">Strategic priorities</p><h2>Building the conditions for better science.</h2><p>Our priorities connect funding, capability, knowledge, and partnerships into a long-term ecosystem.</p></div><ol class="priority-list">{priorities.map(([number, title, text]) => <li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>

  <section class="what-we-do section-space"><div class="container"><p class="section-kicker">What we do</p><h2>Programmes with a clear purpose.</h2><div class="work-grid"><a href="/programmes-grants"><strong>Funding &amp; grants</strong><span>Peer-reviewed support for research and capacity building.</span></a><a href="/educational-support"><strong>Education &amp; training</strong><span>Courses, workshops, mentoring, and professional development.</span></a><a href="/publications"><strong>Publishing &amp; conferences</strong><span>Open access, scientific exchange, and research visibility.</span></a><a href="/partnerships"><strong>Partnerships</strong><span>Cross-sector collaboration with academic and industry partners.</span></a></div></div></section>

  <section class="governance section-space section-alt"><div class="container governance__inner"><div><p class="section-kicker">Governance &amp; transparency</p><h2>Trust is part of the infrastructure.</h2><p>Our governance model connects the Board of Trustees, specialist committees, public policies, reporting, and open scientific practice.</p></div><div class="governance__flow"><span>Board of Trustees</span><i></i><span>Committees</span><i></i><span>Policies &amp; reporting</span><i></i><span>Open access</span></div><a href="/governance" class="btn-fluent-primary">Explore governance</a></div></section>
  <PromoCTASection />
</BaseLayout>

<style>
  .section-space { padding-block: clamp(4.5rem, 9vw, 8rem); } .section-kicker { color: var(--color-primary); font-size: .75rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; margin-bottom: .85rem; } .section-heading { max-width: 44rem; margin-bottom: 2.75rem; }
  .intro__grid, .vision__grid, .priorities__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 7vw, 8rem); align-items: center; } .intro__statement { font-size: clamp(1.85rem, 3.2vw, 3.25rem); line-height: 1.18; letter-spacing: -.035em; color: var(--color-text-primary); font-weight: 700; } .intro__copy { display: grid; gap: 1rem; }
  .vision__image { min-height: 34rem; border-radius: var(--radius-xl); background: url('https://images.unsplash.com/photo-1576086213369-97a306d36557?q=85&w=1200&auto=format&fit=crop') center / cover; } .vision__content h2, .priorities__intro h2, .what-we-do h2, .governance h2 { font-size: clamp(2rem, 3.8vw, 3.4rem); letter-spacing: -.035em; } .vision__pair { display: grid; gap: 1.75rem; margin-top: 2rem; }.vision__pair h3 { margin-bottom: .4rem; }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }.value { min-height: 14rem; padding: 1.75rem; background: var(--color-surface); }.value span { color: var(--color-primary); font-size: .75rem; font-weight: 800; }.value h3 { margin: 2rem 0 .5rem; }.value--feature { background: var(--color-primary); }.value--feature span, .value--feature h3, .value--feature p { color: #fff; }
  .priorities { background: #0d1829; color: #fff; }.priorities h2, .priorities p, .priority-list h3 { color: inherit; }.priorities__intro p:last-child { color: rgba(255,255,255,.7); margin-top: 1rem; }.priorities .section-kicker { color: #7dd3fc; }.priority-list { list-style: none; display: grid; }.priority-list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid rgba(255,255,255,.16); }.priority-list span { color: #7dd3fc; font-weight: 800; }.priority-list h3 { font-size: 1.1rem; margin-bottom: .25rem; }.priority-list p { color: rgba(255,255,255,.68); font-size: .94rem; }
  .work-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 2.5rem; border-top: 1px solid var(--color-border); }.work-grid a { padding: 1.5rem 1.25rem 1.5rem 0; display: grid; gap: .6rem; border-bottom: 1px solid var(--color-border); }.work-grid a + a { padding-left: 1.25rem; border-left: 1px solid var(--color-border); }.work-grid strong { color: var(--color-text-primary); font-size: 1.05rem; }.work-grid span { color: var(--color-text-secondary); font-size: .9rem; }.work-grid a:hover strong { color: var(--color-primary); }
  .governance__inner { display: grid; grid-template-columns: 1.2fr 1fr auto; align-items: center; gap: 3rem; }.governance__flow { display: grid; gap: .75rem; }.governance__flow span { color: var(--color-text-primary); font-weight: 700; }.governance__flow i { height: 1.4rem; width: 1px; background: var(--color-primary); margin-left: .4rem; }
  @media (max-width: 900px) { .intro__grid, .vision__grid, .priorities__grid, .governance__inner { grid-template-columns: 1fr; gap: 2.5rem; }.values-grid { grid-template-columns: repeat(2, 1fr); }.work-grid { grid-template-columns: repeat(2, 1fr); }.work-grid a:nth-child(3) { padding-left: 0; border-left: 0; } } @media (max-width: 600px) { .vision__image { min-height: 20rem; }.values-grid, .work-grid { grid-template-columns: 1fr; }.work-grid a, .work-grid a + a, .work-grid a:nth-child(3) { padding-left: 0; border-left: 0; } }
</style>
