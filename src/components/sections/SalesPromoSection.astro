---
import { homeContent } from '../../config/home';

export interface Props { title?: string; subtitle?: string; }
const { title = 'Programmes & Grants', subtitle = 'Explore the ways UKABCS supports research, learning, collaboration and scientific progress.' } = Astro.props;
---

<section class="py-20 section-sales-promo" id="programmes">
  <div class="container">
    <div class="section-heading max-w-3xl mb-12">
      <span class="badge-pill mb-3">Programmes & grants</span>
      <h2 class="text-3xl font-bold mb-3">{title}</h2>
      <p class="text-secondary">{subtitle}</p>
    </div>
    <div class="grid-3 gap-6">
      {homeContent.programmes.map((programme) => (
        <a href={programme.href} class="card-aceternity programme-card">
          <span class="programme-arrow" aria-hidden="true">↗</span>
          <h3 class="font-bold text-xl mb-3">{programme.title}</h3>
          <p class="text-secondary text-sm leading-relaxed">{programme.description}</p>
          <span class="programme-link">Explore programme <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .programme-card { min-height: 220px; padding: 1.75rem; display: flex; flex-direction: column; color: inherit; text-decoration: none; background: var(--color-surface); }
  .programme-arrow { color: var(--color-primary); font-weight: 800; margin-left: auto; }
  .programme-link { margin-top: auto; padding-top: 1.5rem; color: var(--color-primary); font-weight: 700; font-size: .9rem; }
</style>