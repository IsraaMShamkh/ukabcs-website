---
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Built for Institutional Research & Open-Science Excellence",
  subtitle = "Discover the core pillars of the UK-Arab Association for Biotechnology & Computational Science."
} = Astro.props;
---

<section class="py-20 section-bento" id="features">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="badge-pill mb-3">Aceternity Bento Showcase</span>
      <h2 class="text-3xl font-bold mb-3">{title}</h2>
      <p class="text-secondary">{subtitle}</p>
    </div>

    <!-- Aceternity Style Bento Grid -->
    <div class="bento-grid">
      <!-- Item 1: Large Featured Pill (Span 8) -->
      <div class="bento-col-8 card-aceternity bento-card flex-col justify-between">
        <div class="bento-header mb-6">
          <span class="badge-pill mb-2">Pillar 01 • Grant Funding</span>
          <h3 class="text-2xl font-bold mb-2">Transparent Peer-Reviewed Academic Grants</h3>
          <p class="text-secondary max-w-xl leading-relaxed">
            UKABCS allocates direct financial support for early-career researchers, PhD students, and graduation projects across UK & Arab universities with zero administrative overhead.
          </p>
        </div>

        <div class="bento-media-wrap card-image-wrap" style="height: 220px;">
          <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?q=80&w=1000&auto=format&fit=crop" alt="Academic Grants" loading="lazy" />
        </div>
      </div>

      <!-- Item 2: Vertical Card (Span 4) -->
      <div class="bento-col-4 card-aceternity bento-card flex-col justify-between">
        <div>
          <span class="badge-pill badge-emerald mb-2">Pillar 02 • High Performance</span>
          <h3 class="text-xl font-bold mb-2">HPC Compute Clusters</h3>
          <p class="text-secondary text-sm leading-relaxed mb-4">
            Direct allocation of GPU/CPU node hours for heavy genomic sequencing, AlphaFold 3 predictions, and molecular docking simulations.
          </p>
        </div>

        <div class="bento-media-wrap card-image-wrap" style="height: 180px;">
          <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=600&auto=format&fit=crop" alt="HPC Clusters" loading="lazy" />
        </div>
      </div>

      <!-- Item 3: Span 4 -->
      <div class="bento-col-4 card-aceternity bento-card flex-col justify-between">
        <div>
          <span class="badge-pill mb-2">Pillar 03 • Open Access</span>
          <h3 class="text-xl font-bold mb-2">100% APC Journal Waivers</h3>
          <p class="text-secondary text-sm leading-relaxed mb-4">
            Fully fund open-access Article Processing Charges (APC) for accepted research papers in high-impact Q1/Q2 PubMed journals.
          </p>
        </div>

        <div class="bento-stat-highlight p-4 flat-surface text-center">
          <div class="text-3xl font-bold text-primary-color">£120K+</div>
          <div class="text-xs text-muted">APC Journal Fees Covered</div>
        </div>
      </div>

      <!-- Item 4: Span 8 -->
      <div class="bento-col-8 card-aceternity bento-card flex-col justify-between">
        <div class="bento-header mb-4">
          <span class="badge-pill mb-2">Pillar 04 • Open Source Tools</span>
          <h3 class="text-2xl font-bold mb-2">Scientific Software & Pipeline Support</h3>
          <p class="text-secondary max-w-xl leading-relaxed">
            We champion scientific code reproducibility by sponsoring open-source R/Python bioinformatic packages, Docker containers, and Nextflow workflows.
          </p>
        </div>

        <div class="flex gap-3 mt-2">
          <span class="badge-pill">Nextflow Pipelines</span>
          <span class="badge-pill">AlphaFold & PyMOL</span>
          <span class="badge-pill">Bioconductor R</span>
          <span class="badge-pill">Docker Containers</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-card {
    min-height: 320px;
    display: flex;
    flex-direction: column;
  }

  .bento-stat-highlight {
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
  }
</style>
