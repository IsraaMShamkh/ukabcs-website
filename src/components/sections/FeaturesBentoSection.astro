---
import { homeContent } from '../../config/home';

export interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  sectionId?: string;
  items?: Array<{ title: string; description: string }>;
}
const {
  title = 'What We Do',
  subtitle = 'Practical support for a connected, responsible and inclusive scientific community.',
  badge = 'Our work',
  sectionId = 'what-we-do',
  items = homeContent.whatWeDo,
} = Astro.props;
---

<section class="py-20 section-bento" id={sectionId}>
  <div class="container">
    <div class="section-heading max-w-3xl mb-12">
      <span class="badge-pill mb-3">{badge}</span>
      <h2 class="text-3xl font-bold mb-3">{title}</h2>
      <p class="text-secondary">{subtitle}</p>
    </div>
    <div class="bento-grid">
      {items.map((item, index) => (
        <article class:list={['card-aceternity', 'bento-card', index === 0 ? 'bento-col-8' : index === 3 ? 'bento-col-8' : 'bento-col-4']}>
          <span class="bento-index">0{index + 1}</span>
          <h3 class="text-xl font-bold mb-3">{item.title}</h3>
          <p class="text-secondary leading-relaxed">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento-card { min-height: 200px; padding: 2rem; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(145deg, var(--color-surface), var(--color-bg-secondary)); }
  .bento-index { font-size: .75rem; font-weight: 800; letter-spacing: .14em; color: var(--color-primary); margin-bottom: auto; }
</style>
