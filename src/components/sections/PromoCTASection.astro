---
export interface Props {
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
  tertiaryBtnText?: string;
  tertiaryBtnHref?: string;
}

const {
  title = 'Ready to join UKABCS?',
  subtitle = 'Discover the programmes, resources, funding, and international connections available to the UKABCS scientific community.',
  primaryBtnText = 'Apply for Membership',
  primaryBtnHref = '/memberships',
  secondaryBtnText = 'Join as a Partner',
  secondaryBtnHref = '/partnerships',
  tertiaryBtnText = 'Contact Us',
  tertiaryBtnHref = '#contact'
} = Astro.props;
---

<section class="promo-cta" id="contact">
  <div class="container promo-content">
    <span class="promo-kicker">UKABCS Community</span>
    <h2>{title}</h2>
    <p>{subtitle}</p>
    <div class="cta-actions">
      <a href={primaryBtnHref} class="btn-fluent-primary">
        {primaryBtnText} <span aria-hidden="true">→</span>
      </a>
      {secondaryBtnText && (
        <a href={secondaryBtnHref} class="btn-fluent-secondary">
          {secondaryBtnText}
        </a>
      )}
      {tertiaryBtnText && (
        <a href={tertiaryBtnHref} class="btn-fluent-secondary btn-contact-trigger" data-open-modal="true">
          {tertiaryBtnText}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .promo-cta {
    padding: clamp(5rem, 8vw, 7rem) 0;
    background: var(--color-navy, #081731);
    color: #ffffff;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .promo-content {
    max-width: 58rem;
    margin: 0 auto;
  }

  .promo-kicker {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 800;
    color: #7dd3fc;
    margin-bottom: 0.5rem;
  }

  .promo-cta h2 {
    color: #ffffff;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 1rem auto;
  }

  .promo-cta p {
    max-width: 44rem;
    margin: 0 auto 2.25rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .promo-cta .btn-fluent-primary {
    background: #ffffff;
    color: var(--color-primary, #0284c7);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  .promo-cta .btn-fluent-primary:hover {
    background: #eaf6fd;
  }

  .promo-cta .btn-fluent-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.52);
  }

  .promo-cta .btn-fluent-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #ffffff;
  }
</style>