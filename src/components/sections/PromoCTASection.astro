---
export interface Props {
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
}

const {
  title = "Accelerate Your Scientific Research with UKABCS",
  subtitle = "Apply for peer-reviewed grant calls, join our UK-Arab bioinformatics network, and publish open-access research with 100% APC waivers.",
  primaryBtnText = "Apply Portal",
  primaryBtnHref = "https://docs.google.com/forms/d/e/1FAIpQLScXGZkM3_bWzGgQ8k9zK0L1a4z9b6Z5y7x8v9w0a1b2c3d4e5/viewform",
  secondaryBtnText = "Explore Grant Calls",
  secondaryBtnHref = "/programmes-grants"
} = Astro.props;
---

<section class="py-16 section-promo-cta">
  <div class="container">
    <div class="promo-box card-aceternity p-12 text-center">
      <span class="badge-pill badge-emerald mb-4">Official Non-Profit Academic Call</span>
      <h2 class="text-3xl font-bold mb-4 max-w-3xl mx-auto">{title}</h2>
      <p class="text-lg text-secondary mb-8 max-w-2xl mx-auto leading-relaxed">{subtitle}</p>
      
      <div class="cta-actions flex-center gap-4">
        <a href={primaryBtnHref} target="_blank" rel="noopener noreferrer" class="btn-fluent-primary text-base py-3 px-8">
          <span>{primaryBtnText}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>

        <a href={secondaryBtnHref} class="btn-fluent-secondary text-base py-3 px-8">
          <span>{secondaryBtnText}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .promo-box {
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg-secondary) 100%);
    border: 1px solid var(--color-border);
  }

  .flex-center {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
