---
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Endorsements from University Researchers & Grant Awardees",
  subtitle = "Hear from academic leads who expanded their computational biology labs with UKABCS support."
} = Astro.props;

const testimonials = [
  {
    quote: "The UKABCS Capacity Building Grant enabled our laboratory to procure dedicated GPU servers for cancer genomics. The peer-review process was transparent and remarkably swift.",
    author: "Dr. Khaled Abdel-Rahman",
    title: "Associate Professor of Bioinformatics",
    institution: "Ain Shams University",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=300&auto=format&fit=crop"
  },
  {
    quote: "Publishing our structural biology findings in an open-access PubMed journal would have been financially prohibitive without UKABCS covering 100% of our APC fees.",
    author: "Dr. Rebecca Sterling",
    title: "Senior Research Fellow",
    institution: "University of Manchester",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=300&auto=format&fit=crop"
  },
  {
    quote: "As a final-year student, receiving the UKABCS Graduation Project Grant gave me access to high-performance HPC clusters that made my protein folding thesis possible.",
    author: "Youssef El-Din",
    title: "MSc Computational Biology Graduate",
    institution: "Alexandria University",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=300&auto=format&fit=crop"
  }
];
---

<section class="py-20 section-testimonialsAlt" id="testimonials">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="badge-pill mb-3">Community Voices</span>
      <h2 class="text-3xl font-bold mb-3">{title}</h2>
      <p class="text-secondary">{subtitle}</p>
    </div>

    <div class="grid-3 gap-6">
      {testimonials.map((item) => (
        <div class="card-aceternity testimonial-card p-8 flex-col justify-between">
          <p class="quote-text text-secondary leading-relaxed mb-6">"{item.quote}"</p>

          <div class="author-row flex items-center gap-4 pt-4 border-t border-border">
            <div class="author-avatar">
              <img src={item.avatar} alt={item.author} loading="lazy" />
            </div>
            <div>
              <h4 class="font-bold text-sm text-primary">{item.author}</h4>
              <p class="text-xs text-secondary">{item.title}</p>
              <p class="text-xs text-muted">{item.institution}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .quote-text {
    font-size: 0.95rem;
    font-style: italic;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    overflow: hidden;
    flex-shrink: 0;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
