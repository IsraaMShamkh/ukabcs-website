---
import { siteConfig } from '../../config/site';
---
<section class="general-support py-24" id="general-support">
  <div class="support-image" aria-hidden="true"></div>
  <div class="support-overlay" aria-hidden="true"></div>
  <div class="container support-content">
    <div class="support-intro">
      <span class="badge-pill support-badge mb-4">Research support</span>
      <h2>Have a research need that does not fit a current call?</h2>
      <p>UKABCS is here to help researchers find the right route for promising work and meaningful scientific progress.</p>
    </div>
    <div class="support-detail">
      <h3>How UKABCS can help</h3>
      <ul>
        <li><strong>Opportunities</strong><span>Identify relevant programmes, calls and collaboration routes.</span></li>
        <li><strong>Research guidance</strong><span>Direct researchers toward suitable resources and next steps.</span></li>
        <li><strong>Innovation pathways</strong><span>Help connect research ideas with support that may be available.</span></li>
      </ul>
      <a class="btn-fluent-primary support-action" href={siteConfig.clientFlow.generalSupportForm} target="_blank" rel="noopener noreferrer">Submit a support request <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<style>
.general-support { position:relative; isolation:isolate; min-height:42rem; display:grid; align-items:center; overflow:hidden; background:var(--color-primary-soft); }
.support-image { position:absolute; inset:0; z-index:-2; background:url('https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=90&w=2200&auto=format&fit=crop') center/cover; }
.support-overlay { position:absolute; inset:0; z-index:-1; background:rgba(222,241,251,.92); }
.support-content { display:grid; grid-template-columns:1.05fr .95fr; gap:5rem; align-items:center; padding-top:6rem; padding-bottom:6rem; }
.general-support h2,.general-support h3 { color:var(--color-primary)!important; }
.general-support h2 { max-width:42rem; font-size:clamp(2.5rem,5vw,5rem); line-height:.98; letter-spacing:-.06em; }
.support-intro p { max-width:39rem; margin-top:1.5rem; color:var(--color-text-primary)!important; font-size:1.12rem; }
.support-badge { background:rgba(255,255,255,.72); color:var(--color-primary); border-color:rgba(13,25,42,.12); }
.support-detail { background:rgba(255,255,255,.76); padding:2.25rem; border-radius:var(--radius-lg); box-shadow:var(--shadow-md); }
.support-detail h3 { font-size:1.45rem; margin-bottom:1.35rem; }
.support-detail ul { list-style:none; display:grid; gap:1rem; }
.support-detail li { display:grid; gap:.15rem; padding-left:1rem; border-left:3px solid var(--color-accent); }
.support-detail strong { color:var(--color-primary); font-size:.98rem; }
.support-detail span { color:var(--color-text-secondary); font-size:.92rem; }
.support-action { margin-top:1.8rem; }
@media(max-width:800px){.general-support{min-height:auto}.support-content{grid-template-columns:1fr;gap:2rem;padding-top:5rem;padding-bottom:5rem}.support-detail{padding:1.5rem}}
</style>