---
import { getCollection } from 'astro:content';

const partnersCollection = await getCollection('partnerships');
const partners = partnersCollection.map(p => ({
  name: p.data.partnerName,
  type: p.data.type,
  slug: p.slug,
  image: p.data.image,
  initials: p.data.partnerName
    ? p.data.partnerName.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase()
    : 'UK'
}));

// Fallback Partner list with real brand assets
const fallbackPartners = [
  { name: 'Bioinformatics Gate', type: 'Training Partner', slug: 'bioinformatics-gate-35k', initials: 'BG', image: '/partners/be7dcb13-5351-451b-921a-abd55739aea8.jpeg' },
  { name: 'EBO Bio Solution', type: 'Strategic Partner', slug: 'ebo-bio-solution-150k', initials: 'EB', image: '/partners/0e79b389-8500-4630-a8b2-a71cd8768b1d.jpeg' },
  { name: 'IJBTCS Journal', type: 'Publishing Partner', slug: 'ijbtcs-220k', initials: 'IJ', image: '/partners/ChatGPT Image Sep 13, 2026, 03_41_34 PM.png' },
  { name: 'Exovion', type: 'Tech Partner', slug: 'exovion-10k', initials: 'EX', image: '/partners/Blue Purple Modern Molecule Technology Logo.jpg' },
  { name: 'Healora', type: 'Biotech Partner', slug: 'healora-12k', initials: 'HO', image: '/partners/Untitled design.png' },
  { name: 'ClientFlow CRM', type: 'CRM & Systems Partner', slug: 'clientflow-crm', initials: 'CF', image: '/partners/Clint Flow CRM.png' }
];

const activePartners = partners.length > 0 ? partners : fallbackPartners;

// Duplicate for continuous seamless marquee loop
const marqueeList = [...activePartners, ...activePartners, ...activePartners];
---

<section class="partner-ribbon py-16" aria-labelledby="partners-title">
  <div class="container">
    <div class="text-center mb-10">
      <span class="badge-pill mb-3">Partnerships</span>
      <h2 id="partners-title" class="text-2xl font-bold">Our Partners &amp; Collaborators</h2>
      <p class="text-secondary mt-2">Connecting researchers, academic societies, and technology partners across the globe.</p>
    </div>
  </div>

  <div class="marquee-wrap">
    <div class="marquee-track">
      {marqueeList.map((partner) => (
        <a href={`/partnerships/${partner.slug}`} class="partner-card-pill">
          <span class="partner-avatar">
            {partner.image ? (
              <img src={partner.image} alt={partner.name} class="partner-avatar-img" />
            ) : (
              <span class="partner-initials">{partner.initials}</span>
            )}
          </span>
          <div class="partner-info">
            <span class="partner-name">{partner.name}</span>
            <span class="partner-type">{partner.type}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .partner-ribbon {
    background-color: var(--color-bg-secondary, #f8fafc);
    border-top: 1px solid var(--color-border, #e2e8f0);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    padding-top: 4rem;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .marquee-wrap {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    padding: 1rem 0;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    animation: marquee 35s linear infinite;
    will-change: transform;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  .partner-card-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1.35rem;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-full, 9999px);
    box-shadow: 0 4px 14px rgba(12, 40, 77, 0.07);
    transition: all 0.25s ease;
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .partner-card-pill:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary, #0284c7);
    box-shadow: 0 8px 24px rgba(12, 40, 77, 0.14);
    background: #ffffff;
  }

  .partner-avatar {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 9999px;
    background: var(--color-navy, #0f172a);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .partner-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
  }

  .partner-name {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-text-primary, #0f172a);
    line-height: 1.2;
  }

  .partner-type {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-primary, #0284c7);
    background: var(--color-primary-soft, #e0f2fe);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-sm, 4px);
    display: inline-block;
    width: fit-content;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }
    .marquee-wrap {
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
