---
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "UKABCS Board of Trustees & Executive Council",
  subtitle = "Distinguished researchers, university professors, and computational biology leads steering the UK-Arab Academic Association."
} = Astro.props;

const teamMembers = [
  {
    name: "Prof. Tariq Al-Mansoor",
    role: "President & Chair of Trustees",
    institution: "Imperial College London / UKABCS",
    bio: "Pioneer in computational genomics, structural biology, and cross-border research funding policy.",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=400&auto=format&fit=crop"
  },
  {
    name: "Dr. Elena Rostova",
    role: "VP for Scientific Software & HPC",
    institution: "University of Cambridge",
    bio: "Expert in GPU-accelerated molecular dynamics pipelines, open-source bioinformatics tools, and HPC cluster management.",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=400&auto=format&fit=crop"
  },
  {
    name: "Prof. Ahmed Hassan",
    role: "Director of Arab Region Grants",
    institution: "Cairo University Faculty of Science",
    bio: "Head of computational biology initiatives across North Africa & Middle East, championing early-career grants.",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=400&auto=format&fit=crop"
  },
  {
    name: "Dr. Miriam Vance",
    role: "Head of Audit & Due Diligence",
    institution: "Oxford University Science Secretariat",
    bio: "Specialist in non-profit charity compliance, peer-review integrity, and transparent grant allocation standards.",
    avatar: "https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=400&auto=format&fit=crop"
  }
];
---

<section class="py-20 section-team" id="team">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="badge-pill mb-3">Academic Leadership</span>
      <h2 class="text-3xl font-bold mb-3">{title}</h2>
      <p class="text-secondary">{subtitle}</p>
    </div>

    <div class="grid-4 gap-6">
      {teamMembers.map((member) => (
        <div class="card-aceternity team-card text-center">
          <div class="avatar-wrap mx-auto mb-4">
            <img src={member.avatar} alt={member.name} loading="lazy" />
          </div>
          <h3 class="font-bold text-lg mb-1">{member.name}</h3>
          <p class="text-primary-color font-semibold text-xs mb-1">{member.role}</p>
          <p class="text-muted text-xs mb-3">{member.institution}</p>
          <p class="text-secondary text-sm leading-relaxed">{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .avatar-wrap {
    width: 90px;
    height: 90px;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 2px solid var(--color-primary-soft);
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
