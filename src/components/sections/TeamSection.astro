---
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "UKABCS Board of Trustees & Directors",
  subtitle = "The Board of Trustees of the UK Association for Biotechnology & Computational Science (UKABCS) is the highest governing body responsible for the Association’s strategic direction, compliance with UK law, and the preservation of transparency and research integrity."
} = Astro.props;

const boardMembers = [
  {
    name: "Ms. Israa Mohamed Shamkh",
    country: "UK / Egypt",
    role: "Trustee / Partnerships & Strategic Development Lead",
    institution: "EBO Bio Solution Ltd / UKABCS",
    bio: "Israa M. Shamkh is the Head of Computational Chemistry and a Full-Stack Developer at EBO Bio Solution Ltd, specialising in AI-driven drug discovery and the development of advanced computational platforms.",
    avatar: "/board/board_member_5.jpg",
    initials: "IS"
  },
  {
    name: "Mr. Khizar Hayat",
    country: "UK",
    role: "Managing Director",
    institution: "UKABCS Executive Operations",
    bio: "Administrative Director responsible for legal compliance, operations, and corporate governance in the UK. Oversees registration, reporting, and alignment with UK Companies House and Charity Commission regulations.",
    avatar: "", // Explicitly no photo per user audio directive
    initials: "KH"
  },
  {
    name: "Prof. Dr. Ihosvany Camps",
    country: "Brazil",
    role: "Trustee / Scientific Advisor",
    institution: "Federal University of Alfenas, Brazil",
    bio: "Full Professor of Physics at the Federal University of Alfenas, Brazil. CRO Manager, Scientific Supervisor, and Editor-in-Chief. Expert in academic collaboration, computational modelling, and scientific innovation.",
    avatar: "/board/board_member_1.jpg",
    initials: "IC"
  },
  {
    name: "Dr. Mahmoud Abdel Rahman",
    country: "USA",
    role: "Trustee / Ethics & EDI Lead",
    institution: "Northeastern University, USA",
    bio: "Lecturer at Northeastern University (USA). CRO Manager, Scientific Supervisor, and Instructor. Responsible for ethical oversight, research integrity, and Equality, Diversity & Inclusion (EDI) initiatives within UKABCS.",
    avatar: "/board/board_member_3.jpg",
    initials: "MA"
  },
  {
    name: "Dr. Amina Ibrahim Dirar",
    country: "",
    role: "Partnerships & Strategic Development Lead",
    institution: "",
    bio: "",
    avatar: "/board/board_member_7.jpg",
    initials: "AD"
  },
  {
    name: "Dr. Mohamed Soliman",
    country: "Azerbaijan",
    role: "Trustee / Research Monitoring & Grants Reporting Lead",
    institution: "Western Caspian University, Baku",
    bio: "Department of Life Sciences, Western Caspian University, Baku, Azerbaijan. Oversees research progress and ensures high-quality reporting of scientific outcomes.",
    avatar: "/board/board_member_2.jpg",
    initials: "MS"
  },
  {
    name: "Mr. Mahmoud Ayman El Morsy",
    country: "Egypt",
    role: "Trustee / Accreditation & Grants Coordinator",
    institution: "Research Associate & Accreditation Coordinator",
    bio: "Oversees the academic quality of training programmes and assists in coordinating grants and research evaluations.",
    avatar: "/board/board_member_4.jpg",
    initials: "ME"
  }
];
---

<section class="py-20 section-team" id="board-members">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="badge-pill mb-3">Governance & Leadership</span>
      <h2 class="text-3xl font-bold mb-3">{title}</h2>
      <p class="text-secondary">{subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {boardMembers.map((member) => (
        <div class="card-aceternity team-card p-6 flex flex-col justify-between text-left h-full border border-border/80 hover:border-primary/50 transition-all">
          <div>
            <div class="flex items-center gap-4 mb-4">
              {member.avatar ? (
                <img
                  src={member.avatar}
                  alt={member.name}
                  class="w-14 h-14 rounded-full object-cover border-2 border-primary/20 shrink-0"
                  loading="lazy"
                />
              ) : (
                <div class="w-14 h-14 rounded-full bg-primary/10 text-primary font-extrabold text-base flex items-center justify-center border-2 border-primary/30 shrink-0">
                  {member.initials}
                </div>
              )}
              <div>
                <h3 class="font-bold text-base text-foreground line-clamp-1">{member.name}</h3>
                {member.country && <span class="badge-pill text-[11px] py-0.5 px-2 mt-1">{member.country}</span>}
              </div>
            </div>

            <p class="text-primary-color font-bold text-xs mb-1.5">{member.role}</p>
            {member.institution && <p class="text-muted text-xs mb-3 font-medium">{member.institution}</p>}
            {member.bio && <p class="text-secondary text-xs leading-relaxed">{member.bio}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-team .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .team-card {
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-lg, 12px);
    padding: 1.5rem;
    height: 100%;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .team-card > div > div:first-child {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .team-card img {
    width: 3.5rem !important;
    height: 3.5rem !important;
    max-width: 3.5rem !important;
    flex: 0 0 3.5rem;
    border-radius: 9999px;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .section-team .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .section-team .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
