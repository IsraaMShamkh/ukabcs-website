---
interface Props {
  badge: string;
  title: string;
  text: string;
  items: { title: string; text: string }[];
  ctaText: string;
  ctaHref: string;
  alternate?: boolean;
}

const { badge, title, text, items, ctaText, ctaHref, alternate = false } = Astro.props;
---

<section class:list={['highlight', { 'highlight--alternate': alternate }]}>
  <div class="container">
    <div class="highlight-head">
      <span class="badge-pill">{badge}</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="highlight-grid">
      {items.map(item => (
        <div class="card-aceternity highlight-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
    <div class="highlight-cta">
      <a class="btn-fluent-primary" href={ctaHref}>{ctaText} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .highlight { padding: clamp(4rem, 7vw, 6rem) 0; border-top: 1px solid var(--color-border); }
  .highlight--alternate { background: var(--color-surface); }
  .highlight-head { text-align: center; max-width: 780px; margin: 0 auto 2.5rem; }
  .highlight-head h2 { font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1.16; letter-spacing: -.025em; font-weight: 700; margin: 1rem 0; }
  .highlight-head p { color: var(--color-text-secondary); line-height: 1.75; margin: 0; }
  .highlight-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
  .highlight-card { padding: 1.5rem; border-radius: var(--radius-lg, 16px); }
  .highlight-card h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 .5rem; }
  .highlight-card p { color: var(--color-text-secondary); font-size: .92rem; line-height: 1.65; margin: 0; }
  .highlight-cta { text-align: center; margin-top: 2.5rem; }
</style>
