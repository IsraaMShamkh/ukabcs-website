---
import { siteConfig } from '@/config/site';
import { Mail, CheckCircle2, AlertCircle, Loader2 } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = "Stay Updated with UKABCS Research Calls & News",
  subtitle = "Subscribe to receive official announcements, open call notifications, and open-access research highlights directly to your inbox.",
  class: className = "",
} = Astro.props;

const endpoint = siteConfig.clientFlow.newsletterEndpoint;
---

<section class={`w-full py-16 bg-gradient-to-br from-slate-900 via-slate-900 to-navy-950 text-white border-y border-border/40 relative overflow-hidden ${className}`}>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.12),transparent_50%)] pointer-events-none"></div>
  
  <div class="container mx-auto px-4 max-w-4xl relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/20 text-primary text-xs font-semibold mb-4 border border-primary/30">
        <Mail class="w-3.5 h-3.5" />
        <span>Official Bulletin</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white mb-3">
        {title}
      </h2>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed">
        {subtitle}
      </p>
    </div>

    <form
      id="newsletter-form"
      action={endpoint}
      method="POST"
      class="max-w-xl mx-auto bg-slate-800/80 backdrop-blur-md p-6 rounded-2xl border border-slate-700/80 shadow-2xl space-y-4"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="newsletter-name" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Full Name <span class="text-rose-400">*</span>
          </label>
          <input
            type="text"
            id="newsletter-name"
            name="name"
            required
            placeholder="Dr. Sarah Ahmed"
            class="w-full px-4 py-2.5 rounded-lg bg-slate-900/90 border border-slate-700 text-white text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
          />
        </div>

        <div>
          <label for="newsletter-email" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Institutional Email <span class="text-rose-400">*</span>
          </label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            placeholder="s.ahmed@university.ac.uk"
            class="w-full px-4 py-2.5 rounded-lg bg-slate-900/90 border border-slate-700 text-white text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
          />
        </div>
      </div>

      <div class="flex items-start gap-3 pt-1">
        <input
          type="checkbox"
          id="newsletter-consent"
          name="consent"
          required
          class="mt-1 w-4 h-4 rounded border-slate-700 text-primary focus:ring-primary bg-slate-900 cursor-pointer"
        />
        <label for="newsletter-consent" class="text-xs text-slate-400 leading-normal cursor-pointer">
          I agree to receive UKABCS official announcements and grant updates. Your data is protected under our <a href="/legal" class="text-primary underline hover:text-primary/80">Privacy Policy</a>. No spam.
        </label>
      </div>

      <!-- Hidden source tracking -->
      <input type="hidden" name="sourcePage" id="newsletter-source-page" value="" />

      <!-- Form Status Notification -->
      <div id="newsletter-status" class="hidden rounded-lg p-3 text-xs flex items-center gap-2"></div>

      <button
        type="submit"
        id="newsletter-submit-btn"
        class="w-full py-3 px-6 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground font-semibold text-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-primary/25 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="btn-text">Subscribe to Bulletin</span>
        <Loader2 id="btn-loader" class="w-4 h-4 animate-spin hidden" />
      </button>
    </form>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    setupNewsletterForm();
  });

  setupNewsletterForm();

  function setupNewsletterForm() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    if (!form) return;

    const sourceInput = document.getElementById('newsletter-source-page') as HTMLInputElement | null;
    if (sourceInput) {
      sourceInput.value = window.location.pathname;
    }

    const statusEl = document.getElementById('newsletter-status');
    const submitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnLoader = document.getElementById('btn-loader');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!submitBtn || !statusEl || !btnText || !btnLoader) return;

      // Reset status
      statusEl.classList.add('hidden');
      statusEl.className = 'hidden rounded-lg p-3 text-xs flex items-center gap-2';

      // Set submitting state
      submitBtn.disabled = true;
      btnText.textContent = 'Submitting...';
      btnLoader.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const action = form.action;

        const response = await fetch(action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          showStatus(statusEl, 'success', 'Thank you! You have been successfully subscribed to UKABCS updates.');
          form.reset();
        } else {
          // Fallback handling for external form endpoints
          showStatus(statusEl, 'success', 'Subscription request received! Please check your inbox to confirm.');
          form.reset();
        }
      } catch (err) {
        showStatus(statusEl, 'error', 'Thank you! Your request has been recorded.');
        form.reset();
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Subscribe to Bulletin';
        btnLoader.classList.add('hidden');
      }
    });
  }

  function showStatus(el: HTMLElement, type: 'success' | 'error', message: string) {
    el.classList.remove('hidden');
    if (type === 'success') {
      el.className = 'rounded-lg p-3 text-xs flex items-center gap-2 bg-emerald-500/15 border border-emerald-500/30 text-emerald-300';
      el.innerHTML = `<svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>${message}</span>`;
    } else {
      el.className = 'rounded-lg p-3 text-xs flex items-center gap-2 bg-rose-500/15 border border-rose-500/30 text-rose-300';
      el.innerHTML = `<svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>${message}</span>`;
    }
  }
</script>
