---
import { ArrowRight, Building2 } from 'lucide-astro';

export interface Props {
  title: string;
  partnerName?: string;
  partnerLogo?: string;
  contributionType?: string;
  contributionValue?: string;
  value?: string;
  type?: string;
  description?: string;
  slug: string;
}

const {
  title,
  partnerName = 'Partner Organisation',
  partnerLogo,
  contributionType,
  contributionValue,
  value,
  type,
  description,
  slug,
} = Astro.props;

const displayContribution = contributionValue || value || '';
const displayType = contributionType || type || 'Academic Partnership';
---

<article class="flex flex-col justify-between h-full p-6 rounded-xl bg-card border border-border/80 shadow-sm hover:border-primary/40 transition-all duration-300 group">
  <div class="space-y-4">
    <!-- Top Header: Logo Left, Contribution Badge Right -->
    <div class="flex items-center justify-between gap-3 pb-3 border-b border-border/60">
      <div class="flex items-center gap-3">
        {partnerLogo ? (
          <img
            src={partnerLogo}
            alt={partnerName}
            class="w-10 h-10 rounded-full object-cover border border-border/60 shrink-0"
          />
        ) : (
          <div class="w-10 h-10 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center shrink-0">
            {partnerName.substring(0, 2).toUpperCase()}
          </div>
        )}
        <div>
          <span class="font-bold text-foreground text-sm block group-hover:text-primary transition-colors">
            {partnerName}
          </span>
          <span class="text-xs text-muted-foreground font-medium block">
            {displayType}
          </span>
        </div>
      </div>

      {displayContribution && (
        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 shrink-0">
          {displayContribution}
        </span>
      )}
    </div>

    <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors line-clamp-2">
      <a href={`/partnerships/${slug}`}>{title}</a>
    </h3>

    {description && (
      <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">
        {description}
      </p>
    )}
  </div>

  <div class="pt-4 mt-6 border-t border-border/60">
    <a
      href={`/partnerships/${slug}`}
      class="w-full py-2.5 px-4 rounded-lg bg-secondary hover:bg-primary hover:text-primary-foreground text-foreground text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors"
    >
      <span>Read Partnership Details</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </a>
  </div>
</article>
