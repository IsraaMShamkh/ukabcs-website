---
export interface Props {
  title: string;
  description: string;
  href: string;
  tag?: string;
  image?: string;
}

const { title, description, href, tag = "Grant Program", image } = Astro.props;

const defaultImage = "https://images.unsplash.com/photo-1507668077129-56e32842fceb?q=80&w=800&auto=format&fit=crop";
const tileImage = image || defaultImage;
---

<a href={href} class="card-aceternity program-tile">
  {image && (
    <div class="card-image-wrap tile-image-wrap">
      <img src={tileImage} alt={title} loading="lazy" />
      <span class="badge-pill image-badge">{tag}</span>
    </div>
  )}

  <div class="tile-body">
    {!image && (
      <div class="tile-header">
        <span class="badge-pill">{tag}</span>
        <div class="tile-arrow">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </div>
    )}

    <h3 class="tile-title">{title}</h3>
    <p class="tile-desc">{description}</p>

    <div class="tile-footer">
      <span class="tile-btn-text">Explore Terms & Application</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </div>
  </div>
</a>

<style>
  .program-tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    gap: 1.25rem;
    text-decoration: none;
  }

  .tile-image-wrap {
    height: 170px;
  }

  .image-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .tile-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .tile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .tile-arrow {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .tile-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .tile-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tile-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }
</style>
