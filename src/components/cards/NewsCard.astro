---
import { ArrowRight, Calendar, User } from 'lucide-astro';

export interface Props {
  title: string;
  contentType?: 'research-article' | 'news' | 'open-call' | 'announcement';
  datePublished: string;
  category?: string;
  author?: string;
  summary?: string;
  description?: string;
  slug: string;
  featuredImage?: string;
  image?: string;
}

const {
  title,
  contentType = 'news',
  datePublished,
  category,
  author = 'UKABCS Secretariat',
  summary,
  description,
  slug,
  featuredImage,
  image,
} = Astro.props;

const cardImage = featuredImage || image || "https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?q=80&w=800&auto=format&fit=crop";
const displaySummary = summary || description || '';

const typeBadgeStyles = {
  'research-article': 'bg-primary/10 text-primary border-primary/20',
  'news': 'bg-sky-500/10 text-sky-400 border-sky-500/20',
  'open-call': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  'announcement': 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
};

const typeLabels = {
  'research-article': 'Research Article',
  'news': 'News & Update',
  'open-call': 'Open Call',
  'announcement': 'Announcement',
};
---

<article class="flex flex-col justify-between h-full rounded-xl border border-border/80 bg-card overflow-hidden shadow-sm hover:border-primary/40 transition-all duration-300 group">
  <a href={`/news/${slug}`} class="aspect-video w-full overflow-hidden relative bg-muted block">
    <img
      src={cardImage}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute top-3 left-3">
      <span class={`px-2.5 py-1 text-xs font-semibold rounded-full border backdrop-blur-md ${typeBadgeStyles[contentType]}`}>
        {typeLabels[contentType] || category || 'News'}
      </span>
    </div>
  </a>

  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-3">
      <div class="flex items-center justify-between text-xs text-muted-foreground">
        <span class="flex items-center gap-1">
          <Calendar class="w-3.5 h-3.5 text-primary shrink-0" />
          <span>{new Date(datePublished).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
        </span>
        <span class="flex items-center gap-1">
          <User class="w-3.5 h-3.5 shrink-0" />
          <span>{author}</span>
        </span>
      </div>

      <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors line-clamp-2">
        <a href={`/news/${slug}`}>{title}</a>
      </h3>

      <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">
        {displaySummary}
      </p>
    </div>

    <div class="pt-4 border-t border-border/60">
      <a
        href={`/news/${slug}`}
        class="w-full py-2 px-3 rounded-lg bg-secondary hover:bg-primary hover:text-primary-foreground text-foreground text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors"
      >
        <span>Read Full Story</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</article>
