---
// Landscape UKABCS Certificate of Copyright & Innovation Registration.
// Fields carry data-f hooks so the verification page can fill them in the browser.
export interface Props {
  name?: string;
  position?: string;
  institution?: string;
  title?: string;
  registrationDate?: string;
  serial?: string;
  type?: string;
  validUntil?: string;
  specimen?: boolean;
}
const {
  name = 'Dr. Full Name',
  position = 'Position',
  institution = 'Institution',
  title = 'Title of the Registered Work',
  registrationDate = '27 November 2026',
  serial = 'UKABCS-CR-2026-XXXX-XXXX',
  type = 'Confidential Copyright Registration',
  validUntil = '26 November 2031',
  specimen = false,
} = Astro.props;

const corner = `<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M4 96 V30 Q4 4 30 4 H96" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M14 96 V36 Q14 14 36 14 H96" fill="none" stroke="currentColor" stroke-width=".9"/><path d="M26 40 Q26 26 40 26" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="30" cy="30" r="3.2" fill="currentColor"/><path d="M4 60 Q18 56 22 44 M60 4 Q56 18 44 22" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>`;
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Great+Vibes&display=swap" />

<div class="cert-frame">
  <article class="cert" aria-label="UKABCS Certificate of Copyright and Innovation Registration">
    <div class="cert-pattern" aria-hidden="true"></div>
    <img class="cert-watermark" src="/images/certificate/stamp.png" alt="" aria-hidden="true" />
    <span class="corner tl" set:html={corner} />
    <span class="corner tr" set:html={corner} />
    <span class="corner bl" set:html={corner} />
    <span class="corner br" set:html={corner} />
    <span class="cert-specimen" aria-hidden="true" data-specimen hidden={!specimen}>SPECIMEN</span>

    <div class="cert-inner">
      <header class="cert-head">
        <img class="cert-logo" src="/images/certificate/logo.png" alt="UKABCS" width="788" height="199" />
        <p class="cert-org">UK Organisation for Biotechnology and Computational Science</p>
      </header>

      <div class="cert-titles">
        <p class="cert-title">Certificate</p>
        <p class="cert-subtitle">of Copyright &amp; Innovation Registration</p>
        <span class="cert-rule" aria-hidden="true"><i></i></span>
      </div>

      <div class="cert-body">
        <p class="cert-small">This is to certify that</p>
        <p class="cert-name" data-f="name">{name}</p>
        <p class="cert-small"><span data-f="position">{position}</span>, <span data-f="institution">{institution}</span></p>
        <p class="cert-small">has registered the work entitled</p>
        <p class="cert-work">“<span data-f="title">{title}</span>”</p>
        <p class="cert-small">with the UK Organisation for Biotechnology and Computational Science on <b data-f="registrationDate">{registrationDate}</b>.<br />
        The work is held on record by UKABCS as evidence of its content, authorship and date.</p>
      </div>

      <footer class="cert-foot">
        <dl class="cert-meta">
          <div><dt>Serial Number</dt><dd data-f="serial">{serial}</dd></div>
          <div><dt>Registration</dt><dd data-f="type">{type}</dd></div>
          <div><dt>Held on Record Until</dt><dd data-f="validUntil">{validUntil}</dd></div>
        </dl>
        <div class="cert-seal">
          <span class="seal-ribbon" aria-hidden="true"></span>
          <img src="/images/certificate/stamp.png" alt="UKABCS official stamp" width="293" height="293" />
        </div>
        <div class="cert-sign">
          <img src="/images/certificate/signature.png" alt="Signature of Israa M. Shamkh" width="591" height="127" />
          <span class="cert-line"></span>
          <p class="cert-signer">Israa M. Shamkh</p>
          <p class="cert-role">Trustee, for and on behalf of UKABCS</p>
        </div>
      </footer>

      <p class="cert-note">Private registration record held by UKABCS. It is not a patent or a governmental registration. Verify at ukabcs.co.uk/verify</p>
    </div>
  </article>
</div>

<style>
  .cert-frame { container-type: inline-size; width: 100%; }
  .cert {
    --navy: #13284f;
    --gold: #b08d45;
    --ink: #24314d;
    position: relative;
    aspect-ratio: 1.414 / 1;
    background: #fbf8f0;
    color: var(--ink);
    border: 1.6cqw solid var(--navy);
    box-shadow: 0 24px 50px rgba(11, 29, 58, .22), inset 0 0 0 .35cqw var(--gold);
    font-family: 'Cormorant Garamond', Georgia, serif;
    overflow: hidden;
    text-align: center;
    box-sizing: border-box;
  }
  .cert-pattern {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse at center, rgba(251,248,240,0) 40%, rgba(176,141,69,.10) 100%),
      repeating-radial-gradient(circle at 50% 50%, rgba(19,40,79,.035) 0 .25cqw, transparent .25cqw 1.1cqw);
  }
  .cert-watermark { position: absolute; left: 50%; top: 52%; width: 38cqw; transform: translate(-50%, -50%); opacity: .045; pointer-events: none; }
  .corner { position: absolute; width: 9cqw; height: 9cqw; color: var(--gold); }
  .corner :global(svg) { width: 100%; height: 100%; display: block; }
  .tl { top: 1.4cqw; left: 1.4cqw; }
  .tr { top: 1.4cqw; right: 1.4cqw; transform: scaleX(-1); }
  .bl { bottom: 1.4cqw; left: 1.4cqw; transform: scaleY(-1); }
  .br { bottom: 1.4cqw; right: 1.4cqw; transform: scale(-1, -1); }

  .cert-inner { position: relative; height: 100%; padding: 3.2cqw 7cqw 2cqw; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; }
  .cert-head { display: flex; flex-direction: column; align-items: center; gap: .5cqw; }
  .cert-logo { width: 16cqw; height: auto; }
  .cert-org { margin: 0; font-family: system-ui, sans-serif; font-size: 1.05cqw; letter-spacing: .22em; text-transform: uppercase; color: #5a6a8a; }

  .cert-titles { margin-top: .6cqw; }
  .cert-title { margin: 0; font-size: 5.4cqw; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--navy); line-height: 1; }
  .cert-subtitle { margin: .5cqw 0 0; font-size: 2.3cqw; font-style: italic; font-weight: 500; color: var(--gold); }
  .cert-rule { display: block; position: relative; width: 26cqw; height: .15cqw; margin: 1cqw auto 0; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .cert-rule i { position: absolute; left: 50%; top: 50%; width: .9cqw; height: .9cqw; background: var(--gold); transform: translate(-50%, -50%) rotate(45deg); }

  .cert-body p { margin: .25cqw 0; }
  .cert-small { font-size: 1.65cqw; line-height: 1.4; color: #3a4766; }
  .cert-name { font-family: 'Great Vibes', 'Cormorant Garamond', cursive; font-size: 4.4cqw; line-height: 1.15; color: var(--navy); }
  .cert-work { font-size: 2.05cqw; font-weight: 700; color: var(--navy); line-height: 1.3; padding: 0 4cqw; }

  .cert-foot { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 2cqw; }
  .cert-meta { margin: 0; text-align: left; display: grid; gap: .45cqw; }
  .cert-meta dt { font-family: system-ui, sans-serif; font-size: .85cqw; text-transform: uppercase; letter-spacing: .14em; color: var(--gold); }
  .cert-meta dd { margin: 0; font-family: system-ui, sans-serif; font-size: 1.2cqw; font-weight: 700; color: var(--navy); }
  .cert-seal { position: relative; width: 12.5cqw; height: 12.5cqw; display: grid; place-items: center; }
  .cert-seal img { position: relative; width: 100%; height: auto; transform: rotate(-10deg); opacity: .92; }
  .seal-ribbon { position: absolute; inset: 6%; border-radius: 50%; background: radial-gradient(circle, rgba(176,141,69,.18) 0 60%, rgba(176,141,69,.32) 61% 64%, transparent 65%); }
  .cert-sign { display: flex; flex-direction: column; align-items: center; }
  .cert-sign img { width: 16cqw; height: auto; margin-bottom: -.4cqw; }
  .cert-line { width: 19cqw; border-top: .12cqw solid var(--navy); }
  .cert-signer { margin: .4cqw 0 0; font-size: 1.6cqw; font-weight: 700; color: var(--navy); }
  .cert-role { margin: 0; font-size: 1.15cqw; font-style: italic; color: #5a6a8a; }
  .cert-note { margin: .6cqw 0 0; font-family: system-ui, sans-serif; font-size: .8cqw; letter-spacing: .04em; color: #7b869c; }

  .cert-specimen { position: absolute; inset: 0; display: grid; place-items: center; font: 700 10cqw/1 system-ui, sans-serif; color: rgba(19, 40, 79, .06); transform: rotate(-16deg); pointer-events: none; letter-spacing: .12em; }
  .cert-specimen[hidden] { display: none; }
</style>
