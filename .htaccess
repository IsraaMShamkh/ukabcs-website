Options -Indexes

# Astro generates one index.html per route. Hostinger serves these files directly.
DirectoryIndex index.html

# Keep hashed Astro assets cached, while allowing HTML to update after deployment.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpg|jpeg|gif|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
